<?xml version="1.0" encoding="utf-8"?>
<!-- 1.4: the USB devices the app reads (web/scripts/android-usb.mjs puts this filter on the activity, with the
     USB_DEVICE_ATTACHED intent filter). Android then offers, in its permission dialog, to always use the app with the
     device, and keeps that permission when the device leaves the bus and comes back: the FNIRSI does it at every
     change of mode. Ids in decimal (the form every Android version reads); they must match the Kotlin plugins
     (tests/fnirsi-real-plataformas-unidad.spec.ts). -->
<resources>
    <!-- FNIRSI 2C53T with the «stock-link» patch: 0x1209:0x0001 is the shared pid.codes test id, so the name too -->
    <usb-device vendor-id="4617" product-id="1" product-name="2C53T stock-link" />
    <!-- Brymen BU-86X cable (BM869s) -->
    <usb-device vendor-id="2080" product-id="1" />
</resources>
