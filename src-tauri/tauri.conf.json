{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Electrónica Práctica Avanzada",
  "mainBinaryName": "electronica-practica-avanzada",
  "version": "0.6.0",
  "identifier": "es.gonzalomejias.electronica",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../web"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Electrónica Práctica Avanzada",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "publisher": "Gonzalo Mejías",
    "copyright": "© Gonzalo Mejías",
    "category": "Education",
    "shortDescription": "Lector de «Electrónica Práctica Avanzada»",
    "longDescription": "Lector privado y sin conexión del libro «Electrónica Práctica Avanzada»: capítulos, figuras, ecuaciones, referencias cruzadas, glosario, búsqueda, marcadores y notas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {}
}
