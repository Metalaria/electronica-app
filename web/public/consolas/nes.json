rca","buses":["audio_video"],"funcion":"FC2 es la ferrita de la salida de vídeo; FC1 filtra la alimentación del modulador."},{"id":"P3","nombre":"Modulador de RF y salidas A/V","pieza":"MOD RF (P3)","esquema":["P3"],"bloque":"av","cajas":[[1095,585,1590,1160]],"confianza":"posicion","buses":["audio_video","power"],"funcion":"Caja blindada que convierte el vídeo compuesto y el audio en señal de antena (canal 3/4) y los saca también por las dos tomas RCA."}],"grupos":{"cpu_address":"Direcciones de la CPU (A0–A15)","cpu_data":"Datos de la CPU (D0–D7)","ppu_address_data":"Bus de la PPU (AD0–AD7, PA0–PA13)","clocks":"Relojes","cpu_control":"Control de la CPU (R/W, /NMI, /IRQ, /RST)","ppu_control":"Control de la PPU (ALE, /RD, /WE)","chip_selects":"Selecciones de chip","controllers":"Mandos","cic":"CIC (bloqueo regional)","expansion":"Puerto de expansión","audio_video":"Audio y vídeo","power":"Alimentación"},"hojas":[{"id":0,"nombre":"NES-CPU-11 (OpenTendo)","ruta":"/","archivo":"nes/hoja-0","ancho":419.989,"alto":297.002,"padre":null}],"componentes":{"BC1":{"v":"103-25","l":"C_Small","h":[0]},"BC2":{"v":"103-25","l":"C_Small","h":[0]},"C1":{"v":"100uF","l":"C_Polarized_Small","h":[0]},"C2":{"v":"10nF","l":"C_Small","h":[0]},"C3":{"v":"10nF","l":"C_Small","h":[0]},"C4":{"v":"10nF","l":"C_Small","h":[0]},"C5":{"v":"330pF","l":"C","h":[0]},"C6":{"v":"220pF","l":"C_Small","h":[0]},"C7":{"v":"220pF","l":"C_Small","h":[0]},"C8":{"v":"100nF","l":"C_Small","h":[0]},"C9":{"v":"2.2uF","l":"C_Polarized_Small","h":[0]},"C10":{"v":"10nF","l":"C_Small","h":[0]},"C11":{"v":"10nF","l":"C_Small","h":[0]},"C12":{"v":"10nF","l":"C_Small","h":[0]},"C13":{"v":"10nF","l":"C_Small","h":[0]},"C14":{"v":"10nF","l":"C_Small","h":[0]},"C15":{"v":"10nF","l":"C_Small","h":[0]},"C16":{"v":"10nF","l":"C_Small","h":[0]},"C17":{"v":"10nF","l":"C_Small","h":[0]},"C18":{"v":"10nF","l":"C_Small","h":[0]},"C19":{"v":"10nF","l":"C_Small","h":[0]},"C20":{"v":"220pF","l":"C_Small","h":[0]},"C21":{"v":"220pF","