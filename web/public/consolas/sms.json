uentes":[{"titulo":"Sega, manual de servicio del Master System II (abril de 1991), esquema 171-5922A en 3 hojas","autor":"Sega Enterprises (escaneo de SMS Power)","url":"https://www.smspower.org/Development/SegaMasterSystemIIServiceManual","licencia":"Copyright de Sega; solo consulta privada, no se incluye","uso":"Fuente del esquema: transcrito a mano hoja por hoja (pines, valores y conexiones) y redibujado aquí; cada componente está en la hoja del manual donde aparece («hoja N»)."},{"titulo":"slowcoder/SMSSchematic — KiCad del SMS1 «Power Base VA1» (171-5534)","autor":"slowcoder (2016)","url":"https://github.com/slowcoder/SMSSchematic","licencia":"Sin licencia: solo consulta privada, no se incluye","uso":"Solo para comprobar la transcripción (Z80, VRAM 4168, ranura de cartucho y VDP; resultado en «Comprobación»)."},{"titulo":"Foto de la placa IC BD M4Jr. PAL (M4JrPALTop.jpg)","autor":"ConsoleMods Wiki (colaboradores)","url":"https://consolemods.org/wiki/Master_System:171-5922A_Board_Info","licencia":"Creative Commons Attribution (pie del wiki)","uso":"Foto principal: placa montada de la misma familia que la 171-5922A del manual (fechada el 16-04-1992)."},{"titulo":"Escaneo de la placa 171-5922A sin componentes (171-5922ATop.jpg)","autor":"ConsoleMods Wiki (colaboradores)","url":"https://consolemods.org/wiki/Master_System:171-5922A_Board_Info","licencia":"Creative Commons Attribution (pie del wiki)","uso":"Segunda foto: la serigrafía (IC1–IC9, CN1–CN4…) coincide con las referencias del manual."},{"titulo":"SMS Power: documentación técnica (reloj, mapa de memoria, puertos, VDP)","autor":"Comunidad SMS Power","url":"https://www.smspower.org/Development/Index","licencia":"Solo consulta","uso":"Cifras de la animación: 53,203424 MHz, 228 ciclos por línea, 313 líneas PAL, puertos $3E/$3F/$7E/$7F/$BE/$BF/$DC/$DD, paginador $FFFC–$FFFF."}],"fotos":[{"id":"5922a","titulo":"171-5922A sin componentes","src":"consolas/sms/foto-5922a.jpg","ancho":1600,"alto":1286,"figura":null,"