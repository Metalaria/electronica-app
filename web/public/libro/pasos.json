{"version":1,"items":{"ej-0.6":{"pasos":[{"pregunta":"Primero, la constante de tiempo del circuito.","explicacion":"τ = R · C = 10 000 × 4,7 × 10⁻⁶ = 0,047 s = 47 ms.","pista":"τ = R·C, con R en ohmios y C en faradios.","tipo":"numerico","nombre":"τ","respuesta":{"valor":0.047,"unidad":"s","texto":"47 ms","tol":0.02},"alternativas":[]},{"pregunta":"Tras una constante de tiempo, ¿qué tensión tiene el condensador?","explicacion":"v = 5 · (1 − e⁻¹) = 5 × 0,632 ≈ 3,16 V","pista":"v = V<sub>f</sub>·(1 − e<sup>−t/τ</sup>) con t = τ: el factor es 1 − e<sup>−1</sup> ≈ 0,632.","tipo":"numerico","nombre":"v(τ)","respuesta":{"valor":3.16,"unidad":"V","texto":"3,16 V","tol":0.02},"alternativas":[]}]},"ej-1.1":{"pasos":[{"pregunta":"Empiece por la tensión entre los extremos de la resistencia.","explicacion":"V = I·R = 0,025 × 470 = 11,75 V.","pista":"Ley de Ohm: V = I·R, con la corriente en amperios.","tipo":"numerico","nombre":"V","respuesta":{"valor":11.75,"unidad":"V","texto":"11,75 V","tol":0.02},"alternativas":[]},{"pregunta":"Con esa tensión, ¿qué potencia disipa?","explicacion":"P = V·I = 11,75 × 0,025 = 0,294 W","pista":"P = V·I (o I²·R).","tipo":"numerico","nombre":"P","respuesta":{"valor":0.294,"unidad":"W","texto":"0,294 W","tol":0.02},"alternativas":[]}]},"ej-1.3":{"pasos":[{"pregunta":"¿Cuánto vale la resistencia equivalente del paralelo?","explicacion":"R = (330 × 220)/(330 + 220) = 72600/550 = 132 Ω.","pista":"Dos en paralelo: producto partido por suma.","tipo":"numerico","nombre":"R<sub>eq</sub>","respuesta":{"valor":132.0,"unidad":"Ω","texto":"132 Ω","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué corriente da la fuente de 5 V?","explicacion":"I = 5/132 = 37,9 mA.","pista":"I = V/R<sub>eq</sub>.","tipo":"numerico","nombre":"I","respuesta":{"valor":0.037899999999999996,"unidad":"A","texto":"37,9 mA","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué corriente pasa por la de 330 Ω?","explicacion":"I₁ = 5/330 = 15,2 mA","pista":"Cada rama tiene los 5 V de la fuente.","tipo":"numerico","nombre":"I<sub>1</sub>","respuesta":{"valor":0.0152,"unidad":"A","texto":"15,2 mA","tol":0.02},"alternativas":[]},{"pregunta":"¿Y por la de 220 Ω? (Las dos deben sumar la total.)","explicacion":"I₂ = 5/220 = 22,7 mA","pista":"I<sub>2</sub> = 5 V / 220 Ω.","tipo":"numerico","nombre":"I<sub>2</sub>","respuesta":{"valor":0.0227,"unidad":"A","texto":"22,7 mA","tol":0.02},"alternativas":[]}]},"ej-1.4":{"pasos":[{"pregunta":"¿Qué ecuación plantea el divisor con R<sub>1</sub> = 1 kΩ?","explicacion":"Despejamos: 3,3 = 5 · R₂/(1000+R₂).","pista":"La salida se toma sobre R<sub>2</sub>: V<sub>out</sub> = V<sub>in</sub>·R<sub>2</sub>/(R<sub>1</sub> + R<sub>2</sub>).","tipo":"eleccion","opciones":["3,3 = 5 · R₂/(1000 + R₂)","3,3 = 5 · 1000/(1000 + R₂)","3,3 = 5 · R₂/1000"],"correcta":0,"porque":{"1":"Esa fracción da la tensión en R<sub>1</sub>, no la salida tomada en R<sub>2</sub>.","2":"Falta R<sub>2</sub> en el denominador: la corriente la fijan las dos resistencias en serie."}},{"pregunta":"Despeje R<sub>2</sub>.","explicacion":"R₂ = 1941 Ω.","pista":"Multiplique en cruz: 3300 + 3,3·R<sub>2</sub> = 5·R<sub>2</sub>.","tipo":"numerico","nombre":"R<sub>2</sub>","respuesta":{"valor":1940.0,"unidad":"Ω","texto":"1941 Ω","tol":0.01},"alternativas":[{"valor":2000.0,"texto":"2 kΩ","tol":0.01,"nota":"valor comercial: da 3,33 V"},{"valor":1800.0,"texto":"1,8 kΩ","tol":0.01,"nota":"valor comercial: da 3,21 V"}]}]},"ej-1.5":{"pasos":[{"pregunta":"Primero el valor eficaz de la senoide de 17 V de pico.","explicacion":"V<sub>RMS</sub> = V<sub>p</sub>/√2 = 17/1,414 = 12,02 V.","pista":"En una senoide, V<sub>RMS</sub> = V<sub>p</sub>/√2.","tipo":"numerico","nombre":"V<sub>RMS</sub>","respuesta":{"valor":12.02,"unidad":"V","texto":"12,02 V","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué potencia media disipa la resistencia de 100 Ω?","explicacion":"P = V<sub>RMS²</sub>/R = 12,02²/100 = 144,5/100 = 1,45 W.","pista":"Con el valor eficaz: P = V<sub>RMS</sub>²/R.","tipo":"numerico","nombre":"P","respuesta":{"valor":1.45,"unidad":"W","texto":"1,45 W","tol":0.02},"alternativas":[]}]},"ej-1.6":{"pasos":[{"pregunta":"Pase la sección a metros cuadrados.","explicacion":"A = 2,5 mm² = 2,5 × 10⁻⁶ m².","pista":"1 mm² = 10<sup>−6</sup> m².","tipo":"numerico","nombre":"A","respuesta":{"valor":2.4999999999999998e-06,"unidad":"m²","texto":"2,5 × 10⁻⁶ m²","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuál es la resistencia de los 50 m de cable?","explicacion":"R = ρL/A = (1,72 × 10⁻⁸ × 50)/(2,5 × 10⁻⁶) = 8,6 × 10⁻⁷/2,5 × 10⁻⁶ = 0,344 Ω.","pista":"R = ρ·L/A, con ρ del cobre 1,72 × 10<sup>−8</sup> Ω·m.","tipo":"numerico","nombre":"R","respuesta":{"valor":0.344,"unidad":"Ω","texto":"0,344 Ω","tol":0.02},"alternativas":[]},{"pregunta":"Con 10 A, ¿cuánta tensión cae en el cable?","explicacion":"V = I·R = 10 × 0,344 = 3,44 V","pista":"V = I·R.","tipo":"numerico","nombre":"V","respuesta":{"valor":3.44,"unidad":"V","texto":"3,44 V","tol":0.02},"alternativas":[]},{"pregunta":"¿Y cuánta potencia se pierde en calor?","explicacion":"P = I²R = 100 × 0,344 = 34,4 W","pista":"P = I²·R.","tipo":"numerico","nombre":"P","respuesta":{"valor":34.4,"unidad":"W","texto":"34,4 W","tol":0.02},"alternativas":[]}]},"ej-1.9":{"pasos":[{"pregunta":"¿Cuánta tensión pierde la pila al dar 0,5 A?","explicacion":"La caída es 1,5 − 1,35 = 0,15 V para 0,5 A","pista":"Diferencia entre la tensión en vacío y la tensión con carga.","tipo":"numerico","nombre":"Caída","respuesta":{"valor":0.15,"unidad":"V","texto":"0,15 V","tol":0.0333},"alternativas":[]},{"pregunta":"¿Qué resistencia interna explica esa caída?","explicacion":"la resistencia interna es 0,15/0,5 = 0,3 Ω.","pista":"R = caída / corriente.","tipo":"numerico","nombre":"R<sub>int</sub>","respuesta":{"valor":0.3,"unidad":"Ω","texto":"0,3 Ω","tol":0.06},"alternativas":[]}]},"ej-2.3":{"pasos":[{"pregunta":"¿Cuánto cambia la temperatura?","explicacion":"ΔT = 75 − 25 = 50 °C.","pista":"Temperatura final menos inicial.","tipo":"numerico","nombre":"ΔT","respuesta":{"valor":50.0,"unidad":"°C","texto":"50 °C","tol":0.06},"alternativas":[]},{"pregunta":"Con 50 ppm/°C, ¿qué variación relativa supone?","explicacion":"50 ppm/°C × 50 °C = 2500 ppm = 2500 × 10⁻⁶ = 0,0025 = 0,25 %.","pista":"Coeficiente × ΔT; 1 ppm = 10<sup>−6</sup>.","tipo":"numerico","nombre":"Variación relativa","respuesta":{"valor":0.25,"unidad":"%","texto":"0,25 %","tol_abs":0.005},"alternativas":[]},{"pregunta":"¿Cuántos ohmios son en la de 10 kΩ?","explicacion":"En ohmios: 10000 × 0,0025 = 25 Ω.","pista":"ΔR = R × variación relativa.","tipo":"numerico","nombre":"ΔR","respuesta":{"valor":25.0,"unidad":"Ω","texto":"25 Ω","tol":0.02},"alternativas":[]}]},"ej-2.6":{"pasos":[{"pregunta":"¿Qué tensión debe absorber la resistencia?","explicacion":"V<sub>R</sub> = 5 − 2 = 3 V.","pista":"Alimentación menos la tensión del LED.","tipo":"numerico","nombre":"V<sub>R</sub>","respuesta":{"valor":3.0,"unidad":"V","texto":"3 V","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué resistencia da 15 mA?","explicacion":"R = V<sub>R</sub>/I<sub>F</sub> = 3/0,015 = 200 Ω.","pista":"R = V<sub>R</sub>/I<sub>F</sub>.","tipo":"numerico","nombre":"R","respuesta":{"valor":200.0,"unidad":"Ω","texto":"200 Ω","tol":0.06},"alternativas":[]},{"pregunta":"200 Ω no está en la serie E12. ¿Qué vecino conviene?","explicacion":"los vecinos son 180 Ω y 220 Ω, y el seguro es 220 Ω, por encima del cálculo","pista":"El valor seguro es el que no deja pasar más corriente de la calculada.","tipo":"eleccion","opciones":["180 Ω","220 Ω"],"correcta":1,"porque":{"0":"Por debajo del cálculo: la corriente pasaría de los 15 mA."}},{"pregunta":"¿Qué potencia disipa con 220 Ω?","explicacion":"P = V<sub>R²</sub>/R = 3²/220 = 0,041 W = 41 mW","pista":"P = V<sub>R</sub>²/R.","tipo":"numerico","nombre":"P","respuesta":{"valor":0.041,"unidad":"W","texto":"41 mW","tol":0.03},"alternativas":[{"valor":0.045,"texto":"45 mW","tol":0.03,"nota":"con los 200 Ω calculados"}]}]},"ej-3.1":{"pasos":[{"pregunta":"Pase el área a metros cuadrados.","explicacion":"A = 4 cm² = 4 × 10⁻⁴ m²","pista":"1 cm² = 10<sup>−4</sup> m².","tipo":"numerico","nombre":"A","respuesta":{"valor":0.0004,"unidad":"m²","texto":"4 × 10⁻⁴ m²","tol":0.06},"alternativas":[]},{"pregunta":"Y la separación, a metros.","explicacion":"d = 0,1 mm = 1 × 10⁻⁴ m.","pista":"1 mm = 10<sup>−3</sup> m.","tipo":"numerico","nombre":"d","respuesta":{"valor":0.0001,"unidad":"m","texto":"1 × 10⁻⁴ m","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué capacidad resulta?","explicacion":"= 1,77 × 10⁻¹⁰ F = 177 pF.","pista":"C = ε<sub>0</sub>·ε<sub>r</sub>·A/d, con ε<sub>0</sub> = 8,854 × 10<sup>−12</sup> F/m.","tipo":"numerico","nombre":"C","respuesta":{"valor":1.77e-10,"unidad":"F","texto":"177 pF","tol":0.02},"alternativas":[]}]},"ej-3.2":{"pasos":[{"pregunta":"Calcule la constante de tiempo.","explicacion":"τ = R·C = 2200 × 470 × 10⁻⁶ = 1,034 s.","pista":"τ = R·C.","tipo":"numerico","nombre":"τ","respuesta":{"valor":1.034,"unidad":"s","texto":"1,034 s","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué tensión tiene el condensador tras 1 s?","explicacion":"v = 12 × (1 − e⁻⁰·⁹⁶⁷) = 12 × (1 − 0,380) = 12 × 0,620 = 7,44 V.","pista":"t/τ = 0,967; v = 12·(1 − e<sup>−t/τ</sup>).","tipo":"numerico","nombre":"v(1 s)","respuesta":{"valor":7.44,"unidad":"V","texto":"7,44 V","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuánto tarda en llegar al 99 %?","explicacion":"Para el 99 % se necesitan unos 4,6τ ≈ 4,6 × 1,034 ≈ 4,76 segundos.","pista":"Para el 99 % hacen falta unas 4,6 constantes de tiempo.","tipo":"numerico","nombre":"t<sub>99 %</sub>","respuesta":{"valor":4.76,"unidad":"s","texto":"4,76 s","tol":0.03},"alternativas":[]}]},"ej-3.4":{"pasos":[{"pregunta":"Despeje R de f<sub>c</sub> = 1/(2πRC) para 1 kHz y 100 nF.","explicacion":"R = 1/(2π·f<sub>c</sub>·C) = 1/(2π × 1000 × 100×10⁻⁹) = 1/(6,28 × 10⁻⁴) = 1592 Ω.","pista":"R = 1/(2π·f<sub>c</sub>·C).","tipo":"numerico","nombre":"R","respuesta":{"valor":1590.0,"unidad":"Ω","texto":"1592 Ω","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué valor E12 es el más cercano?","explicacion":"El valor E12 más cercano es 1,5 kΩ (da f<sub>c</sub> = 1061 Hz) o 1,8 kΩ (884 Hz).","pista":"Los vecinos E12 de 1,59 kΩ son 1,5 kΩ y 1,8 kΩ.","tipo":"numerico","nombre":"Valor E12","respuesta":{"valor":1500.0,"unidad":"Ω","texto":"1,5 kΩ","tol":0.005},"alternativas":[{"valor":1800.0,"texto":"1,8 kΩ","tol":0.005,"nota":"da 884 Hz"}]}]},"ej-3.5":{"pasos":[{"pregunta":"¿Qué energía guarda el condensador a 25 V?","explicacion":"W = ½·C·V² = ½ × 2200×10⁻⁶ × 25² = ½ × 2200×10⁻⁶ × 625 = 0,688 J.","pista":"W = ½·C·V².","tipo":"numerico","nombre":"W","respuesta":{"valor":0.688,"unidad":"J","texto":"0,688 J","tol":0.02},"alternativas":[]},{"pregunta":"Si la entrega en 1 ms, ¿qué potencia media es?","explicacion":"P = W/t = 0,688/10⁻³ = 688 W.","pista":"P = W/t.","tipo":"numerico","nombre":"P","respuesta":{"valor":688.0,"unidad":"W","texto":"688 W","tol":0.02},"alternativas":[]}]},"ej-4.1":{"pasos":[{"pregunta":"Pase la sección a metros cuadrados.","explicacion":"A = 1 cm² = 1 × 10⁻⁴ m²","pista":"1 cm² = 10<sup>−4</sup> m².","tipo":"numerico","nombre":"A","respuesta":{"valor":0.0001,"unidad":"m²","texto":"1 × 10⁻⁴ m²","tol":0.06},"alternativas":[]},{"pregunta":"Y la longitud, a metros.","explicacion":"l = 4 cm = 0,04 m.","pista":"1 cm = 0,01 m.","tipo":"numerico","nombre":"l","respuesta":{"valor":0.04,"unidad":"m","texto":"0,04 m","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué inductancia resulta?","explicacion":"= 0,01005/0,04 = 0,251 H","pista":"L = µ<sub>0</sub>·µ<sub>r</sub>·N²·A/l, con µ<sub>0</sub> = 4π × 10<sup>−7</sup>.","tipo":"numerico","nombre":"L","respuesta":{"valor":0.251,"unidad":"H","texto":"0,251 H","tol":0.02},"alternativas":[]}]},"ej-4.3":{"pasos":[{"pregunta":"¿Qué energía guarda la bobina con 0,2 A?","explicacion":"W = ½·L·I² = ½ × 0,1 × 0,2² = ½ × 0,1 × 0,04 = 0,002 J = 2 mJ.","pista":"W = ½·L·I².","tipo":"numerico","nombre":"W","respuesta":{"valor":0.002,"unidad":"J","texto":"2 mJ","tol":0.06},"alternativas":[]},{"pregunta":"Si la corriente se corta en 2 µs, ¿qué pico de tensión aparece?","explicacion":"v = L·di/dt = 0,1 × (0,2/2×10⁻⁶) = 0,1 × 100000 = 10000 V = 10 kV.","pista":"v = L·di/dt.","tipo":"numerico","nombre":"v","respuesta":{"valor":10000.0,"unidad":"V","texto":"10 kV","tol":0.06},"alternativas":[]}]},"ej-4.4":{"pasos":[{"pregunta":"¿Cuál es la relación de transformación?","explicacion":"a = V₁/V₂ = 230/12 = 19,17.","pista":"a = V<sub>1</sub>/V<sub>2</sub>.","tipo":"numerico","nombre":"a","respuesta":{"valor":19.17,"unidad":"","texto":"19,17","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuántas espiras lleva el secundario?","explicacion":"N₂ = N₁/a = 920/19,17 = 48 espiras.","pista":"N<sub>2</sub> = N<sub>1</sub>/a.","tipo":"numerico","nombre":"N<sub>2</sub>","respuesta":{"valor":48.0,"unidad":"","texto":"48","tol":0.01},"alternativas":[]},{"pregunta":"¿Qué corriente toma el primario con 2 A en el secundario?","explicacion":"I₁ = I₂/19,17 = 2/19,17 = 0,104 A = 104 mA.","pista":"Las corrientes van al revés que las tensiones: I<sub>1</sub> = I<sub>2</sub>/a.","tipo":"numerico","nombre":"I<sub>1</sub>","respuesta":{"valor":0.10400000000000001,"unidad":"A","texto":"104 mA","tol":0.02},"alternativas":[]}]},"ej-4.7":{"pasos":[{"pregunta":"Calcule la reactancia ωL a 100 kHz.","explicacion":"ωL = 2π·100 000·100·10⁻⁶ = 62,8 Ω.","pista":"ω = 2π·f.","tipo":"numerico","nombre":"ωL","respuesta":{"valor":62.8,"unidad":"Ω","texto":"62,8 Ω","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué factor Q tiene con 0,5 Ω de resistencia?","explicacion":"Q = 62,8 / 0,5 ≈ 126.","pista":"Q = ωL/R.","tipo":"numerico","nombre":"Q","respuesta":{"valor":126.0,"unidad":"","texto":"126","tol":0.01},"alternativas":[]}]},"ej-5.1":{"pasos":[{"pregunta":"¿Qué tensión debe absorber la resistencia?","explicacion":"V<sub>R</sub> = 12 − 3,2 = 8,8 V","pista":"Alimentación menos la caída del LED.","tipo":"numerico","nombre":"V<sub>R</sub>","respuesta":{"valor":8.8,"unidad":"V","texto":"8,8 V","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué resistencia da 20 mA?","explicacion":"R = 8,8/0,020 = 440 Ω.","pista":"R = V<sub>R</sub>/I<sub>F</sub>.","tipo":"numerico","nombre":"R","respuesta":{"valor":440.0,"unidad":"Ω","texto":"440 Ω","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué valor comercial E12 se toma (el más próximo por encima)?","explicacion":"El valor comercial E12 más próximo por encima es 470 Ω","pista":"Por encima del cálculo, para no pasar de 20 mA.","tipo":"numerico","nombre":"Valor E12","respuesta":{"valor":470.0,"unidad":"Ω","texto":"470 Ω","tol":0.005},"alternativas":[]},{"pregunta":"¿Qué potencia disipa con 470 Ω?","explicacion":"P = V<sub>R²</sub>/R = 8,8²/470 = 77,4/470 = 0,165 W","pista":"P = V<sub>R</sub>²/R.","tipo":"numerico","nombre":"P","respuesta":{"valor":0.165,"unidad":"W","texto":"0,165 W","tol":0.02},"alternativas":[{"valor":0.176,"texto":"0,176 W","tol":0.02,"nota":"con los 440 Ω calculados"}]}]},"ej-5.3":{"pasos":[{"pregunta":"¿Qué resistencia serie da 25 mA en total?","explicacion":"R<sub>s</sub> = (V<sub>in</sub> − V<sub>Z</sub>)/(I<sub>Z</sub> + I<sub>L</sub>) = (12 − 5,1)/0,025 = 6,9/0,025 = 276 Ω.","pista":"R<sub>s</sub> = (V<sub>in</sub> − V<sub>Z</sub>)/(I<sub>Z</sub> + I<sub>L</sub>).","tipo":"numerico","nombre":"R<sub>s</sub>","respuesta":{"valor":276.0,"unidad":"Ω","texto":"276 Ω","tol":0.02},"alternativas":[]},{"pregunta":"Con la de 270 Ω, ¿qué corriente total pasa?","explicacion":"Con 270 Ω la corriente total es 6,9/270 = 25,6 mA","pista":"I = 6,9 V / 270 Ω.","tipo":"numerico","nombre":"I","respuesta":{"valor":0.0256,"unidad":"A","texto":"25,6 mA","tol":0.02},"alternativas":[]},{"pregunta":"Si se desconecta la carga, ¿cuánto disipa el Zener?","explicacion":"el Zener absorbe los 25,6 mA y disipa 5,1 × 0,0256 = 0,13 W","pista":"Sin carga, toda la corriente va al Zener: P = V<sub>Z</sub>·I.","tipo":"numerico","nombre":"P<sub>Z</sub>","respuesta":{"valor":0.13,"unidad":"W","texto":"0,13 W","tol":0.04},"alternativas":[]}]},"ej-5.5":{"pasos":[{"pregunta":"¿Cuánta tensión caen los diodos del puente?","explicacion":"la caída total es de 2 × 0,7 = 1,4 V.","pista":"En un puente conducen dos diodos en serie en cada semiciclo.","tipo":"numerico","nombre":"Caída","respuesta":{"valor":1.4,"unidad":"V","texto":"1,4 V","tol":0.0357},"alternativas":[]},{"pregunta":"¿Qué tensión continua de pico queda?","explicacion":"V<sub>DC</sub> ≈ V<sub>p</sub> − 1,4 = 12 − 1,4 = 10,6 V","pista":"Pico de la entrada menos la caída de los diodos.","tipo":"numerico","nombre":"V<sub>DC</sub>","respuesta":{"valor":10.6,"unidad":"V","texto":"10,6 V","tol":0.02},"alternativas":[]}]},"ej-5.6":{"pasos":[{"pregunta":"¿Qué expresión da el condensador del filtro?","explicacion":"Con onda completa a 50 Hz el rizado es a 100 Hz","pista":"Con onda completa a 50 Hz, ¿a qué frecuencia es el rizado?","tipo":"eleccion","opciones":["C ≈ I/(f<sub>rizado</sub>·V<sub>rizado</sub>), con f<sub>rizado</sub> = 100 Hz","C ≈ I/(2·f·V<sub>rizado</sub>), con f = 100 Hz"],"correcta":0,"porque":{"1":"Es el error frecuente: el factor 2 y los 100 Hz cuentan dos veces la onda completa y dan la mitad del valor necesario."}},{"pregunta":"Calcule C para 0,5 A y 1 V de rizado.","explicacion":"C = 0,5/(100 × 1) = 0,005 F = 5000 µF.","pista":"C = I/(100 Hz × 1 V).","tipo":"numerico","nombre":"C","respuesta":{"valor":0.005,"unidad":"F","texto":"5000 µF","tol":0.02},"alternativas":[{"valor":0.0047,"texto":"4700 µF","tol":0.01,"nota":"valor comercial; rizado ≈ 1,06 V"},{"valor":0.0068,"texto":"6800 µF","tol":0.01,"nota":"valor comercial con margen"}]}]},"ej-5.8":{"pasos":[{"pregunta":"¿Qué corriente total pasa por la resistencia?","explicacion":"la corriente total 20 + 10 = 30 mA","pista":"Corriente del Zener más la de la carga.","tipo":"numerico","nombre":"I","respuesta":{"valor":0.03,"unidad":"A","texto":"30 mA","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué resistencia hace falta?","explicacion":"R = 6,9 / 0,03 = 230 Ω","pista":"R = (V<sub>in</sub> − V<sub>Z</sub>)/I = 6,9 V / I.","tipo":"numerico","nombre":"R","respuesta":{"valor":230.0,"unidad":"Ω","texto":"230 Ω","tol":0.0217},"alternativas":[{"valor":220.0,"texto":"220 Ω","tol":0.005,"nota":"valor comercial"}]},{"pregunta":"¿Cuánto disipa?","explicacion":"Disipa P = 6,9 · 0,03 ≈ 0,21 W","pista":"P = V·I.","tipo":"numerico","nombre":"P","respuesta":{"valor":0.207,"unidad":"W","texto":"0,21 W","tol":0.05},"alternativas":[]}]},"ej-6.1":{"pasos":[{"pregunta":"¿Qué corriente de colector da β = 150 con 30 µA de base?","explicacion":"I<sub>C</sub> = β·I<sub>B</sub> = 150 × 30 × 10⁻⁶ = 4,5 mA.","pista":"I<sub>C</sub> = β·I<sub>B</sub>.","tipo":"numerico","nombre":"I<sub>C</sub>","respuesta":{"valor":0.0045000000000000005,"unidad":"A","texto":"4,5 mA","tol":0.003},"alternativas":[]},{"pregunta":"¿Y la de emisor?","explicacion":"I<sub>E</sub> = I<sub>C</sub> + I<sub>B</sub> = 4,5 mA + 0,03 mA = 4,53 mA","pista":"I<sub>E</sub> = I<sub>C</sub> + I<sub>B</sub>.","tipo":"numerico","nombre":"I<sub>E</sub>","respuesta":{"valor":0.00453,"unidad":"A","texto":"4,53 mA","tol":0.003},"alternativas":[]}]},"ej-6.3":{"pasos":[{"pregunta":"¿Qué corriente de base mínima pide el transistor?","explicacion":"La corriente de base mínima sería I<sub>C</sub>/β = 60/100 = 0,6 mA","pista":"I<sub>B</sub> = I<sub>C</sub>/β.","tipo":"numerico","nombre":"I<sub>B,mín</sub>","respuesta":{"valor":0.0006,"unidad":"A","texto":"0,6 mA","tol":0.06},"alternativas":[]},{"pregunta":"Con un factor de saturación de 5, ¿qué corriente de base se usa?","explicacion":"I<sub>B</sub> = 3 mA.","pista":"5 veces la mínima.","tipo":"numerico","nombre":"I<sub>B</sub>","respuesta":{"valor":0.003,"unidad":"A","texto":"3 mA","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué resistencia de base la da desde el pin de 5 V?","explicacion":"R<sub>B</sub> = (V<sub>pin</sub> − 0,7)/I<sub>B</sub> = (5 − 0,7)/0,003 = 4,3/0,003 = 1433 Ω","pista":"R<sub>B</sub> = (V<sub>pin</sub> − 0,7 V)/I<sub>B</sub>.","tipo":"numerico","nombre":"R<sub>B</sub>","respuesta":{"valor":1430.0,"unidad":"Ω","texto":"1433 Ω","tol":0.02},"alternativas":[{"valor":1000.0,"texto":"1 kΩ","tol":0.01,"nota":"valor elegido, que asegura la saturación"}]}]},"ej-6.5":{"pasos":[{"pregunta":"Sume las resistencias térmicas.","explicacion":"R<sub>total</sub> = R<sub>JC</sub> + R<sub>pasta</sub> + R<sub>disipador</sub> = 2 + 0,5 + 4 = 6,5 °C/W.","pista":"En serie se suman.","tipo":"numerico","nombre":"R<sub>total</sub>","respuesta":{"valor":6.5,"unidad":"°C/W","texto":"6,5 °C/W","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuánto sube la unión sobre el ambiente con 5 W?","explicacion":"ΔT = P × R<sub>total</sub> = 5 × 6,5 = 32,5 °C.","pista":"ΔT = P × R<sub>total</sub>.","tipo":"numerico","nombre":"ΔT","respuesta":{"valor":32.5,"unidad":"°C","texto":"32,5 °C","tol":0.02},"alternativas":[]},{"pregunta":"¿A qué temperatura queda la unión?","explicacion":"T<sub>J</sub> = T<sub>amb</sub> + ΔT = 30 + 32,5 = 62,5 °C","pista":"Ambiente más el incremento.","tipo":"numerico","nombre":"T<sub>J</sub>","respuesta":{"valor":62.5,"unidad":"°C","texto":"62,5 °C","tol":0.02},"alternativas":[]}]},"ej-8.4":{"pasos":[{"pregunta":"Divida la salida deseada entre la referencia de 1,25 V.","explicacion":"9/1,25 = 7,2","pista":"V<sub>out</sub> = 1,25·(1 + R<sub>2</sub>/R<sub>1</sub>).","tipo":"numerico","nombre":"9/1,25","respuesta":{"valor":7.2,"unidad":"","texto":"7,2","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuánto debe valer R<sub>2</sub>/R<sub>1</sub>?","explicacion":"R₂/240 = 6,2","pista":"7,2 = 1 + R<sub>2</sub>/R<sub>1</sub>.","tipo":"numerico","nombre":"R<sub>2</sub>/R<sub>1</sub>","respuesta":{"valor":6.2,"unidad":"","texto":"6,2","tol":0.02},"alternativas":[]},{"pregunta":"Con R<sub>1</sub> = 240 Ω, ¿qué R<sub>2</sub> hace falta?","explicacion":"R₂ = 1488 Ω.","pista":"R<sub>2</sub> = 6,2 × 240 Ω.","tipo":"numerico","nombre":"R<sub>2</sub>","respuesta":{"valor":1488.0,"unidad":"Ω","texto":"1488 Ω","tol":0.02},"alternativas":[{"valor":1500.0,"texto":"1,5 kΩ","tol":0.01,"nota":"valor comercial: 9,06 V"}]}]},"ej-8.5":{"pasos":[{"pregunta":"Despeje R<sub>a</sub> + 2·R<sub>b</sub> para 1 kHz con 100 nF.","explicacion":"(R<sub>a</sub> + 2·R<sub>b</sub>) = 1,44/(f·C) = 1,44/(1000 × 100×10⁻⁹) = 1,44/10⁻⁴ = 14400 Ω.","pista":"De f = 1,44/((R<sub>a</sub> + 2·R<sub>b</sub>)·C).","tipo":"numerico","nombre":"R<sub>a</sub> + 2·R<sub>b</sub>","respuesta":{"valor":14400.0,"unidad":"Ω","texto":"14400 Ω","tol":0.02},"alternativas":[]},{"pregunta":"Con R<sub>a</sub> = 1 kΩ, ¿cuánto vale 2·R<sub>b</sub>?","explicacion":"2·R<sub>b</sub> = 14400 − R<sub>a</sub> = 14400 − 1000 = 13400","pista":"Reste R<sub>a</sub>.","tipo":"numerico","nombre":"2·R<sub>b</sub>","respuesta":{"valor":13400.0,"unidad":"Ω","texto":"13400 Ω","tol":0.02},"alternativas":[]},{"pregunta":"¿Y R<sub>b</sub>?","explicacion":"así R<sub>b</sub> = 6700 Ω.","pista":"La mitad.","tipo":"numerico","nombre":"R<sub>b</sub>","respuesta":{"valor":6700.0,"unidad":"Ω","texto":"6700 Ω","tol":0.02},"alternativas":[{"valor":6800.0,"texto":"6,8 kΩ","tol":0.01,"nota":"valor comercial: unos 986 Hz"}]}]},"ej-10.3":{"pasos":[{"pregunta":"Sume las resistencias térmicas.","explicacion":"R = 1,5 + 0,3 + 2 = 3,8 °C/W.","pista":"En serie se suman.","tipo":"numerico","nombre":"R","respuesta":{"valor":3.8,"unidad":"°C/W","texto":"3,8 °C/W","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuánto sube sobre el ambiente con 10 W?","explicacion":"ΔT = P × R = 10 × 3,8 = 38 °C.","pista":"ΔT = P × R.","tipo":"numerico","nombre":"ΔT","respuesta":{"valor":38.0,"unidad":"°C","texto":"38 °C","tol":0.02},"alternativas":[]},{"pregunta":"¿A qué temperatura queda la unión?","explicacion":"T<sub>unión</sub> = 35 + 38 = 73 °C.","pista":"Ambiente (35 °C) más el incremento.","tipo":"numerico","nombre":"T<sub>unión</sub>","respuesta":{"valor":73.0,"unidad":"°C","texto":"73 °C","tol":0.02},"alternativas":[]}]},"ej-10.6":{"pasos":[{"pregunta":"¿Cuánto puede subir la unión sobre el ambiente?","explicacion":"ΔT = T<sub>unión</sub> − T<sub>ambiente</sub> = 100 − 40 = 60 °C.","pista":"Límite de la unión menos el ambiente.","tipo":"numerico","nombre":"ΔT","respuesta":{"valor":60.0,"unidad":"°C","texto":"60 °C","tol":0.06},"alternativas":[]},{"pregunta":"Con 4 W, ¿qué resistencia térmica total se permite?","explicacion":"R<sub>total</sub> = ΔT/P = 60/4 = 15 °C/W.","pista":"R = ΔT/P.","tipo":"numerico","nombre":"R<sub>total</sub>","respuesta":{"valor":15.0,"unidad":"°C/W","texto":"15 °C/W","tol":0.0333},"alternativas":[]},{"pregunta":"Quitando los 2,5 °C/W de la cápsula y la pasta, ¿cuánto puede tener el disipador?","explicacion":"R<sub>disipador</sub> = 15 − 2,5 = 12,5 °C/W.","pista":"Total menos lo que ya está fijado.","tipo":"numerico","nombre":"R<sub>disipador</sub>","respuesta":{"valor":12.5,"unidad":"°C/W","texto":"12,5 °C/W","tol":0.02},"alternativas":[]}]},"ej-17.4":{"pasos":[{"pregunta":"¿Qué valor de analogWrite() da un 75 %?","explicacion":"valor = 0,75 × 255 = 191.","pista":"analogWrite() va de 0 a 255.","tipo":"numerico","nombre":"valor","respuesta":{"valor":191.0,"unidad":"","texto":"191","tol_abs":1.0},"alternativas":[]},{"pregunta":"¿Qué tensión media entrega el pin?","explicacion":"V = 0,75 × 5 V = 3,75 V","pista":"Ciclo de trabajo × 5 V.","tipo":"numerico","nombre":"V","respuesta":{"valor":3.75,"unidad":"V","texto":"3,75 V","tol":0.02},"alternativas":[]}]},"ej-21.2":{"pasos":[{"pregunta":"¿Cuánto mide la señal de pico a pico?","explicacion":"V<sub>pp</sub> = 4 div × 0,5 V/div = 2 V.","pista":"Divisiones × voltios por división.","tipo":"numerico","nombre":"V<sub>pp</sub>","respuesta":{"valor":2.0,"unidad":"V","texto":"2 V","tol":0.005},"alternativas":[]},{"pregunta":"¿Y de pico?","explicacion":"V<sub>p</sub> = V<sub>pp</sub>/2 = 1 V.","pista":"La mitad del pico a pico.","tipo":"numerico","nombre":"V<sub>p</sub>","respuesta":{"valor":1.0,"unidad":"V","texto":"1 V","tol":0.005},"alternativas":[]},{"pregunta":"¿Cuál es su valor eficaz?","explicacion":"V<sub>RMS</sub> = V<sub>p</sub>/√2 = 1/1,414 = 0,707 V.","pista":"En una senoide, V<sub>p</sub>/√2.","tipo":"numerico","nombre":"V<sub>RMS</sub>","respuesta":{"valor":0.707,"unidad":"V","texto":"0,707 V","tol":0.02},"alternativas":[]}]},"ej-21.3":{"pasos":[{"pregunta":"¿Cuánto dura un periodo?","explicacion":"T = 5 div × 1 ms/div = 5 ms = 0,005 s.","pista":"Divisiones × tiempo por división.","tipo":"numerico","nombre":"T","respuesta":{"valor":0.005,"unidad":"s","texto":"5 ms","tol":0.005},"alternativas":[]},{"pregunta":"¿Qué frecuencia tiene?","explicacion":"f = 1/T = 1/0,005 = 200 Hz.","pista":"f = 1/T.","tipo":"numerico","nombre":"f","respuesta":{"valor":200.0,"unidad":"Hz","texto":"200 Hz","tol":0.005},"alternativas":[]}]},"ej-23.4":{"pasos":[{"pregunta":"¿Con qué carga se entrega la máxima potencia?","explicacion":"La máxima potencia se entrega cuando R<sub>L</sub> = R<sub>Th</sub> = 1,6 Ω.","pista":"Teorema de máxima transferencia: R<sub>L</sub> = R<sub>Th</sub>.","tipo":"numerico","nombre":"R<sub>L</sub>","respuesta":{"valor":1.6,"unidad":"Ω","texto":"1,6 Ω","tol":0.0312},"alternativas":[]},{"pregunta":"¿Cuánta potencia es, con V<sub>Th</sub> = 8 V?","explicacion":"P<sub>máx</sub> = V<sub>Th²</sub>/(4·R<sub>Th</sub>) = 8²/(4 × 1,6) = 64/6,4 = 10 W.","pista":"P<sub>máx</sub> = V<sub>Th</sub>²/(4·R<sub>Th</sub>).","tipo":"numerico","nombre":"P<sub>máx</sub>","respuesta":{"valor":10.0,"unidad":"W","texto":"10 W","tol":0.06},"alternativas":[]}]},"ej-24.3":{"pasos":[{"pregunta":"¿Cuál es la potencia aparente?","explicacion":"S = V · I = 120 × 4 = 480 VA.","pista":"S = V·I.","tipo":"numerico","nombre":"S","respuesta":{"valor":480.0,"unidad":"VA","texto":"480 VA","tol":0.02},"alternativas":[]},{"pregunta":"¿Y la activa, con cos φ = 0,7?","explicacion":"P = S · cos φ = 480 × 0,7 = 336 W.","pista":"P = S·cos φ.","tipo":"numerico","nombre":"P","respuesta":{"valor":336.0,"unidad":"W","texto":"336 W","tol":0.02},"alternativas":[]},{"pregunta":"¿Y la reactiva?","explicacion":"Q = √(S² − P²) = √(480² − 336²) = √117 504 ≈ 342,8 VAr.","pista":"Q = √(S² − P²).","tipo":"numerico","nombre":"Q","respuesta":{"valor":342.8,"unidad":"VAr","texto":"342,8 VAr","tol":0.02},"alternativas":[]}]},"ej-26.3":{"pasos":[{"pregunta":"Con el modelo de caída constante, ¿cuánta tensión cae en la resistencia?","explicacion":"en la resistencia caen 5 − 2 = 3 V","pista":"Alimentación menos la caída del LED.","tipo":"numerico","nombre":"V<sub>R</sub>","respuesta":{"valor":3.0,"unidad":"V","texto":"3 V","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué resistencia da 10 mA?","explicacion":"R = (V<sub>fuente</sub> − V<sub>F</sub>) / I = 3 / 0,01 = 300 Ω.","pista":"R = V<sub>R</sub>/I.","tipo":"numerico","nombre":"R","respuesta":{"valor":300.0,"unidad":"Ω","texto":"300 Ω","tol":0.06},"alternativas":[]}]},"ej-28.4":{"pasos":[{"pregunta":"¿Cuánta tensión cae en el regulador?","explicacion":"La caída es 12 − 5 = 7 V.","pista":"Entrada menos salida.","tipo":"numerico","nombre":"Caída","respuesta":{"valor":7.0,"unidad":"V","texto":"7 V","tol":0.06},"alternativas":[]},{"pregunta":"¿Cuánto disipa con 0,5 A?","explicacion":"Potencia disipada = 7 V × 0,5 A = 3,5 W.","pista":"P = caída × corriente.","tipo":"numerico","nombre":"P","respuesta":{"valor":3.5,"unidad":"W","texto":"3,5 W","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué rendimiento tiene?","explicacion":"Rendimiento η = Vout/Vin = 5/12 ≈ 0,417 = 41,7 %.","pista":"En un lineal, η ≈ V<sub>out</sub>/V<sub>in</sub>.","tipo":"numerico","nombre":"η","respuesta":{"valor":41.7,"unidad":"%","texto":"41,7 %","tol_abs":0.3},"alternativas":[]}]},"ej-33.3":{"pasos":[{"pregunta":"¿Qué ciclo de trabajo tiene el reductor?","explicacion":"D = Vout/Vin = 5/12 ≈ 0,417.","pista":"D = V<sub>out</sub>/V<sub>in</sub>.","tipo":"numerico","nombre":"D","respuesta":{"valor":0.417,"unidad":"","texto":"0,417","tol":0.02},"alternativas":[]},{"pregunta":"¿Cuánto dura un periodo de conmutación?","explicacion":"Periodo T = 1/f = 2 µs.","pista":"T = 1/f.","tipo":"numerico","nombre":"T","respuesta":{"valor":2e-06,"unidad":"s","texto":"2 µs","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué rizado de corriente tiene la bobina de 10 µH?","explicacion":"= 7·0,417·0,2 ≈ 0,58 A.","pista":"ΔI<sub>L</sub> = (V<sub>in</sub> − V<sub>out</sub>)·D·T/L.","tipo":"numerico","nombre":"ΔI<sub>L</sub>","respuesta":{"valor":0.58,"unidad":"A","texto":"0,58 A","tol":0.03},"alternativas":[]}]},"ej-36.1":{"pasos":[{"pregunta":"¿Qué longitud de onda tiene una señal de 100 MHz?","explicacion":"λ = c/f = 3×10⁸ / 100×10⁶ = 3 m.","pista":"λ = c/f.","tipo":"numerico","nombre":"λ","respuesta":{"valor":3.0,"unidad":"m","texto":"3 m","tol":0.06},"alternativas":[]},{"pregunta":"¿Cuánto mide un monopolo de cuarto de onda?","explicacion":"Un monopolo de cuarto de onda mide λ/4 = 0,75 m.","pista":"λ/4.","tipo":"numerico","nombre":"Longitud","respuesta":{"valor":0.75,"unidad":"m","texto":"0,75 m","tol":0.02},"alternativas":[]}]},"ej-36.2":{"pasos":[{"pregunta":"¿Qué coeficiente de reflexión tiene una carga de 75 Ω en 50 Ω?","explicacion":"Γ = (ZL − Z0)/(ZL + Z0) = (75 − 50)/(75 + 50) = 25/125 = 0,2.","pista":"Γ = (Z<sub>L</sub> − Z<sub>0</sub>)/(Z<sub>L</sub> + Z<sub>0</sub>).","tipo":"numerico","nombre":"Γ","respuesta":{"valor":0.2,"unidad":"","texto":"0,2","tol":0.01},"alternativas":[]},{"pregunta":"¿Y la relación de onda estacionaria?","explicacion":"VSWR = (1+0,2)/(1−0,2) = 1,2/0,8 = 1,5.","pista":"VSWR = (1 + |Γ|)/(1 − |Γ|).","tipo":"numerico","nombre":"VSWR","respuesta":{"valor":1.5,"unidad":"","texto":"1,5","tol":0.01},"alternativas":[]}]},"ej-38.1":{"pasos":[{"pregunta":"¿Qué fracción del tiempo está activo?","explicacion":"5 ms de cada 1000 ms = 0,005.","pista":"5 ms de cada segundo.","tipo":"numerico","nombre":"Fracción activa","respuesta":{"valor":0.005,"unidad":"","texto":"0,005","tol":0.06},"alternativas":[]},{"pregunta":"¿Qué consumo medio resulta?","explicacion":"Consumo medio = 0,005·8 mA + 0,995·3 µA = 40 µA + 2,99 µA ≈ 43 µA.","pista":"Media ponderada de los dos estados.","tipo":"numerico","nombre":"I<sub>media</sub>","respuesta":{"valor":4.2999999999999995e-05,"unidad":"A","texto":"43 µA","tol":0.02},"alternativas":[]}]},"ej-43.3":{"pasos":[{"pregunta":"¿Qué transconductancia tiene con 1 mA de colector?","explicacion":"g<sub>m</sub> = I<sub>C</sub>/V<sub>T</sub> = 1 mA / 26 mV ≈ 38,5 mA/V.","pista":"g<sub>m</sub> = I<sub>C</sub>/V<sub>T</sub>, con V<sub>T</sub> ≈ 26 mV.","tipo":"numerico","nombre":"g<sub>m</sub>","respuesta":{"valor":0.0385,"unidad":"A/V","texto":"38,5 mA/V","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué ganancia de tensión da con R<sub>C</sub> = 4,7 kΩ? (Ojo al signo.)","explicacion":"Ganancia ≈ g<sub>m</sub>·R<sub>C</sub> = 0,0385 · 4700 ≈ 181 (unos 45 dB), con signo negativo (invierte fase).","pista":"A<sub>v</sub> ≈ −g<sub>m</sub>·R<sub>C</sub>: el emisor común invierte.","tipo":"numerico","nombre":"A<sub>v</sub>","respuesta":{"valor":-181.0,"unidad":"","texto":"−181","tol":0.02},"alternativas":[{"valor":181.0,"texto":"181","tol":0.02,"nota":"en módulo"}]}]},"ej-47.3":{"pasos":[{"pregunta":"¿Qué resistencia térmica total se permite?","explicacion":"Resistencia térmica total permitida = (T<sub>unión</sub> − T<sub>amb</sub>) / P = (125 − 40) / 4 = 85 / 4 = 21,25 °C/W.","pista":"R = (T<sub>unión</sub> − T<sub>amb</sub>)/P.","tipo":"numerico","nombre":"R<sub>total</sub>","respuesta":{"valor":21.25,"unidad":"°C/W","texto":"21,25 °C/W","tol":0.02},"alternativas":[]},{"pregunta":"Restando los 2 °C/W fijos, ¿cuánto puede tener el disipador?","explicacion":"Restando las fijas: 21,25 − 2 = 19,25 °C/W.","pista":"Total menos lo fijo.","tipo":"numerico","nombre":"R<sub>disipador</sub>","respuesta":{"valor":19.25,"unidad":"°C/W","texto":"19,25 °C/W","tol":0.01},"alternativas":[]}]},"ej-50.5":{"pasos":[{"pregunta":"¿Qué resistencia sensora limita a 2 A con un umbral de 0,65 V?","explicacion":"Rsense = Vumbral / Ilímite = 0,65 V / 2 A = 0,325 Ω.","pista":"R = V<sub>umbral</sub>/I<sub>límite</sub>.","tipo":"numerico","nombre":"R<sub>sense</sub>","respuesta":{"valor":0.325,"unidad":"Ω","texto":"0,325 Ω","tol":0.01},"alternativas":[{"valor":0.33,"texto":"0,33 Ω","tol":0.01,"nota":"valor comercial"}]},{"pregunta":"¿Cuánto disipa a 2 A?","explicacion":"P = I²·R = 2² × 0,33 ≈ 1,3 W","pista":"P = I²·R.","tipo":"numerico","nombre":"P","respuesta":{"valor":1.3,"unidad":"W","texto":"1,3 W","tol":0.03},"alternativas":[]}]},"ej-51.4":{"pasos":[{"pregunta":"¿Qué valor eficaz tiene una senoide de 16 V de pico?","explicacion":"V<sub>RMS</sub> = V<sub>pico</sub> / √2 = 16 / √2 ≈ 11,3 V.","pista":"V<sub>RMS</sub> = V<sub>pico</sub>/√2.","tipo":"numerico","nombre":"V<sub>RMS</sub>","respuesta":{"valor":11.3,"unidad":"V","texto":"11,3 V","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué potencia llega al altavoz de 8 Ω?","explicacion":"P = (11,3)² / 8 ≈ 128 / 8 ≈ 16 W.","pista":"P = V<sub>RMS</sub>²/R.","tipo":"numerico","nombre":"P","respuesta":{"valor":16.0,"unidad":"W","texto":"16 W","tol":0.0312},"alternativas":[]}]},"ej-53.7":{"pasos":[{"pregunta":"¿Qué corriente de base da la resistencia de 1 MΩ?","explicacion":"I<sub>B</sub> = (9 − 0,65)/1 MΩ = 8,35 µA","pista":"I<sub>B</sub> = (9 V − V<sub>BE</sub>)/R<sub>B</sub>.","tipo":"numerico","nombre":"I<sub>B</sub>","respuesta":{"valor":8.35e-06,"unidad":"A","texto":"8,35 µA","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué corriente de colector indica la caída de 1,25 V en 1 kΩ?","explicacion":"I<sub>C</sub> = 1,25 V / 1 kΩ = 1,25 mA","pista":"I<sub>C</sub> = V/R.","tipo":"numerico","nombre":"I<sub>C</sub>","respuesta":{"valor":0.00125,"unidad":"A","texto":"1,25 mA","tol":0.02},"alternativas":[]},{"pregunta":"¿Qué h<sub>FE</sub> tiene el transistor?","explicacion":"hFE = 1,25 mA / 8,35 µA ≈ 150.","pista":"h<sub>FE</sub> = I<sub>C</sub>/I<sub>B</sub>.","tipo":"numerico","nombre":"h<sub>FE</sub>","respuesta":{"valor":150.0,"unidad":"","texto":"150","tol":0.02},"alternativas":[]}]}},"total":45,"pasos":116}