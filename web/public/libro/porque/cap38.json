{"version":1,"parte":"cap38","repaso":{"cap38-01":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-02":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-03":{"0":{"k":"general"},"1":{"k":"propio","html":"Los estados de espera de la Flash afectan al procesador, que lee mal el programa y se cuelga si sube la frecuencia antes de ajustarlos; un periférico que no responde ni da error suele tener el reloj sin habilitar."},"2":{"k":"general"}},"cap38-04":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap38-05":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-06":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-07":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap38-08":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-09":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-11":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-12":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-13":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap38-14":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap38-15":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap38-16":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap38-17":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap38-19":{"0":{"k":"general"},"2":{"k":"propio","html":"La interrupción sí puede escribirla; el problema es que el compilador no lo sabe: sin volatile, la lee una sola vez antes del bucle (un lds y un rjmp sobre sí mismo)."},"3":{"k":"propio","html":"Que valga cero al arrancar es lo esperado: el bucle espera a que la interrupción la cambie. Se queda colgado porque, sin volatile, la lectura se hace una sola vez, antes del bucle."}}},"ejercicios":{"ej-38.4/p1":{"1":{"k":"general"},"2":{"k":"general"}}},"prediccion":{"cap38-pred-sec-38.6":{"baja":{"k":"general"},"igual":{"k":"general"}}}}