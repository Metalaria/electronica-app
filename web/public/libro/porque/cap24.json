{"version":1,"parte":"cap24","repaso":{"cap24-01":{"0":{"k":"libro","html":"La forma en que lo hace depende solo de los componentes, no de ninguna fuente: en un circuito RC o RL es una exponencial que decae con la constante de tiempo τ; en un RLC puede ser una exponencial o una oscilación amortiguada.","ref":"sec-24.1","donde":"Sección 23.1"},"1":{"k":"general"},"2":{"k":"general"}},"cap24-03":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap24-04":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap24-05":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap24-06":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap24-07":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap24-09":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap24-10":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap24-11":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap24-12":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap24-13":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap24-14":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap24-15":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap24-16":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"libro","html":"<strong>Buscando el máximo de corriente</strong>, que en un circuito de Q bajo es una curva plana y poco precisa.","ref":"sec-24.7","donde":"Sección 23.7"}},"cap24-17":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap24-19":{"0":{"k":"libro","html":"<strong>Capacidad entre espiras y entre bobinados</strong>, que a frecuencia alta cortocircuita el transformador y —peor en aislamiento— <strong>deja pasar el ruido de modo común</strong> a través de la barrera.","ref":"sec-24.9","donde":"Sección 23.9"},"2":{"k":"general"},"3":{"k":"general"}}},"ejercicios":{"ej-24.2/p1":{"0":{"k":"general"},"1":{"k":"general"}}},"prediccion":{}}