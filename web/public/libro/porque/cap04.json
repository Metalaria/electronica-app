{"version":1,"parte":"cap04","repaso":{"cap04-01":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-02":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-04":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap04-05":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-06":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-07":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-08":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"libro","html":"Su saturación es baja (0,3 a 0,5 T) comparada con la del hierro, y <strong>su permeabilidad depende mucho de la temperatura</strong>, con una temperatura de Curie por encima de la cual desaparece por completo (desde unos 120 °C en las de permeabilidad muy alta hasta algo más de 200 °C en las de potencia).","ref":"sec-4.4","donde":"Sección 4.4"}},"cap04-09":{"0":{"k":"libro","html":"<strong>El contacto se abre más despacio</strong>, y arquea más tiempo: paradójicamente, el diodo protege el transistor y <strong>acorta la vida del contacto</strong>.","ref":"sec-4.5","donde":"Sección 4.5"},"1":{"k":"general"},"2":{"k":"general"}},"cap04-10":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap04-11":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-12":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-13":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-14":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap04-15":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-16":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap04-18":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap04-19":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}}},"ejercicios":{},"prediccion":{}}