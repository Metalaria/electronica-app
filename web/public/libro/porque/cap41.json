{"version":1,"parte":"cap41","repaso":{"cap41-02":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-03":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-04":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-05":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-06":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-07":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-08":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap41-09":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap41-10":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-11":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-13":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-14":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-15":{"0":{"k":"libro","html":"<strong>Terminación Thévenin</strong> (dos resistencias de 100 Ω a alimentación y masa, equivalentes a 50 Ω hacia 1,65 V): en cualquiera de los dos niveles una de las dos resistencias tiene los 3,3 V encima, 3,3²/100 = 109 mW por línea, <strong>constantes</strong>, lo que da 3,48 W con 32 líneas sea cual sea el patrón de datos.","ref":"prob-41.A","donde":"Problema 42.A"},"1":{"k":"general"},"2":{"k":"general"}},"cap41-16":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap41-17":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"libro","html":"Por eso el problema empeora con la <strong>longitud</strong> del tramo paralelo, y acortarlo es tan eficaz como separar.","ref":"prob-41.C","donde":"Problema 42.C"}}},"ejercicios":{"prob-41.A/p1":{"1":{"k":"general"},"2":{"k":"general"}}},"prediccion":{"cap41-pred-sec-41.3":{"baja":{"k":"general"},"igual":{"k":"general"}}}}