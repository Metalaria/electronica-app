{"version":1,"parte":"cap32","repaso":{"cap32-02":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap32-04":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-05":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-06":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-07":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap32-08":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-09":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap32-10":{"0":{"k":"libro","html":"De ahí una conclusión práctica: <strong>para campos eléctricos, cualquier conductor fino sirve</strong>; para campos magnéticos de baja frecuencia, hace falta <strong>material ferromagnético</strong> y espesor, porque la reflexión no funciona y hay que desviar el flujo.","ref":"sec-32.7","donde":"Sección 31.7"},"2":{"k":"general"},"3":{"k":"general"}},"cap32-11":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap32-12":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-13":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"libro","html":"La reducción es directamente visible, y hacer lo mismo con un condensador X —que no cambia nada, porque filtra el otro modo— es la demostración práctica de por qué distinguir ambos modos no es un tecnicismo.","ref":"sec-32.9","donde":"Sección 31.9"}},"cap32-14":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-15":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap32-16":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap32-17":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap32-18":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap32-20":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}}},"ejercicios":{"prob-32.A/p1":{"0":{"k":"general"},"2":{"k":"general"}}},"prediccion":{}}