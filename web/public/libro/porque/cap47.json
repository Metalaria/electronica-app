{"version":1,"parte":"cap47","repaso":{"cap47-01":{"0":{"k":"libro","html":"<strong>Verdadero valor eficaz</strong> para alterna no senoidal, que es casi toda la de un circuito electrónico.","ref":"sec-47.1","donde":"Sección 48.1"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-02":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-04":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-05":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-06":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-07":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-08":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-09":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap47-10":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap47-12":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap47-13":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap47-14":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-15":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-16":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap47-17":{"1":{"k":"propio","html":"En TT la corriente de defecto vuelve por el terreno, limitada por las tomas de tierra: 10,5 A en el ejemplo, menos que los 16 A del magnetotérmico, y mucho menos de lo que fundiría el fusible de la acometida. Solo el diferencial la detecta."},"2":{"k":"general"},"3":{"k":"general"}},"cap47-19":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap47-20":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap47-22":{"1":{"k":"propio","html":"El transformador no limita la corriente a 30 mA: aísla. Las corrientes del secundario circulan dentro de la isla y no pasan por el diferencial del cuadro, que no las ve."},"2":{"k":"general"},"3":{"k":"general"}}},"ejercicios":{"prob-47.C/p1":{"0":{"k":"general"}}},"prediccion":{"cap47-pred-sec-47.2":{"baja":{"k":"general"},"igual":{"k":"general"}},"cap47-pred-sec-47.4":{"sube":{"k":"general"},"baja":{"k":"general"}}}}