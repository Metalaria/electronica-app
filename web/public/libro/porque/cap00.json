{"version":1,"parte":"cap00","repaso":{"cap00-01":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-02":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap00-03":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-05":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap00-07":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-09":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-11":{"0":{"k":"general"},"1":{"k":"general"},"3":{"k":"general"}},"cap00-12":{"0":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap00-13":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-18":{"0":{"k":"libro","html":"Un argumento de exponencial, logaritmo o función trigonométrica <strong>debe</strong> ser adimensional: e^(−t/τ) tiene sentido porque t/τ es segundos entre segundos; e^(−t) con t en segundos no significa nada, y ver una exponencial cuyo argumento tiene unidades es señal segura de que falta una constante de tiempo.","ref":"sec-0.15","donde":"Sección 0.16"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-20":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap00-21":{"1":{"k":"general"},"2":{"k":"general"},"3":{"k":"general"}},"cap00-22":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}},"cap00-24":{"0":{"k":"general"},"2":{"k":"propio","html":"SPICE no resuelve la exponencial de forma exacta: en cada iteración la sustituye por su tangente y resuelve un circuito lineal. Por eso puede necesitar muchas iteraciones (175 en el ejemplo, más que su límite de 100)."},"3":{"k":"general"}},"cap00-25":{"0":{"k":"general"},"1":{"k":"general"},"2":{"k":"general"}}},"ejercicios":{},"prediccion":{"cap00-pred-sec-0.2":{"baja":{"k":"general"},"igual":{"k":"general"}},"cap00-pred-sec-new-0-numericos":{"baja":{"k":"general"},"igual":{"k":"general"}},"cap00-pred-sec-new-0-resumen":{"baja":{"k":"general"},"igual":{"k":"general"}}}}