istal","tipo":"porque","fase":"Por qué","titulo":[{"t":"txt","s":"Un cristal en el óhmetro"}],"texto":[{"t":"txt","s":"El óhmetro marca OL en un cristal. ¿Por qué esa lectura no concluye nada?"}],"libro":["cap53#689"],"fijar":{},"inicio":{},"widget":{"tipo":"figura","fuente":{"origen":"libro","src":"fig/53.31.svg","vista":[0,0,450.72,198.72],"vectorial":true,"alt":"Figura 55.41: Cómo comprobar transformadores, bobinas y cristales, y lo que un óhmetro no detecta.","num":"55.41"},"zonas":[{"id":"cristal","rotulo":[{"t":"txt","s":"Arriba a la derecha"}],"rects":[[302,4,145,118]]},{"id":"bobina","rotulo":[{"t":"txt","s":"Arriba en el centro"}],"rects":[[153,4,146,118]]}],"mandos":[],"ocultar":false},"opciones":[{"texto":[{"t":"txt","s":"En continua es un abierto, sano o roto"}],"bien":true,"porque":[{"t":"txt","s":"La única comprobación válida es verlo oscilar en su circuito con la sonda ×10."}]},{"texto":[{"t":"txt","s":"Porque el óhmetro no llega a megaohmios"}],"bien":false,"porque":[{"t":"txt","s":"Sí llega: el cristal no conduce nada en continua, ni sano ni roto."}]},{"texto":[{"t":"txt","s":"Porque OL indica que está bien"}],"bien":false,"porque":[{"t":"txt","s":"Uno que no oscila marca lo mismo: OL no distingue."}]}],"escalera":[[{"t":"txt","s":"¿Conduce un cristal en continua cuando está sano?"}]],"solucion":[{"t":"txt","s":"Nada: hay que verlo oscilar con la sonda ×10."}]},{"id":"banco-resonancia","tipo":"banco","fase":"En el banco","titulo":[{"t":"txt","s":"Mida una bobina por resonancia"}],"texto":[{"t":"txt","s":"Bobina de 10 mH en paralelo con 100 nF, alimentados desde el generador a través de 1 kΩ. Busque el máximo de amplitud."}],"libro":["cap53#686"],"fijar":{"L_b":0.01,"C_k":1e-7,"R_gs":1000},"inicio":{},"actividad":{"tipo":"banco","piezas":[[{"t":"txt","s":"Bobina de 10 mH"}],[{"t":"txt","s":"Condensador de 100 nF medido con el Brymen"}],[{"t":"txt","s":"R = 1 kΩ"}],[{"t":"txt","s":"Generador y osciloscopio del FNIRSI"}]],"medir":[{"t":"txt","s":"La fr