 abajo"}],"rects":[[8,82,60,27]]},{"id":"motor","rotulo":[{"t":"txt","s":"El motor"}],"rects":[[30,116,40,38]]},{"id":"paro","rotulo":[{"t":"txt","s":"Mando, segundo contacto"}],"rects":[[150,61,58,28]]},{"id":"s1","rotulo":[{"t":"txt","s":"Mando, a la izquierda"}],"rects":[[150,92,52,28]]},{"id":"retencion","rotulo":[{"t":"txt","s":"Mando, a la derecha"}],"rects":[[208,92,50,28]]},{"id":"bobina","rotulo":[{"t":"txt","s":"Mando, abajo"}],"rects":[[170,142,50,26]]}],"mandos":[],"ocultar":false},"opciones":[{"texto":[{"t":"txt","s":"Contra un contactor con los contactos soldados"}],"bien":true,"porque":[{"t":"txt","s":"Soldado, tiene la bobina sin tensión y su auxiliar cerrado: el eléctrico no lo ve."}]},{"texto":[{"t":"txt","s":"Contra excitar las dos bobinas a la vez"}],"bien":false,"porque":[{"t":"txt","s":"Eso ya lo cubre el eléctrico: un contacto cerrado de cada contactor en serie con la bobina del otro."}]},{"texto":[{"t":"txt","s":"Contra un error del programa del autómata"}],"bien":false,"porque":[{"t":"txt","s":"El enclavamiento por programa se añade a los dos, no los sustituye; el mecánico es otra cosa."}]}],"escalera":[[{"t":"txt","s":"¿Qué fallo deja al auxiliar del contactor diciendo lo contrario de lo que pasa?"}]],"solucion":[{"t":"txt","s":"El mecánico cubre el contactor soldado; el eléctrico, la pulsación de los dos."}]},{"id":"resumen","tipo":"resumen","fase":"Resumen","titulo":[{"t":"txt","s":"Lección completada"}],"texto":[],"libro":["cap55#7","cap55#9","cap55#10","cap55#15","cap55#18"],"fijar":{},"inicio":{},"ideas":[{"titulo":[{"t":"txt","s":"Contactos y Boole."}],"texto":[{"t":"txt","s":"En serie, Y; en paralelo, O; un contacto cerrado, la negación."}]},{"titulo":[{"t":"txt","s":"Autorretención."}],"texto":[{"t":"txt","s":"S1 en paralelo con el 13-14 de KM1 y el paro cerrado en serie: biestable con prioridad de paro."}]},{"titulo":[{"t":"txt","s":"Estrella-triángulo."}],"texto":[{"t":"txt","s":"Un tercio de corriente y de par, enclavamientos y u