7"],"fijar":{},"inicio":{},"estimar":{"objetivo":"I_bC","unidad":"A","min":0,"max":0.1,"paso":0.001,"inicio":0.005,"tol":0.04,"rotulo":[{"t":"txt","s":"I"},{"t":"sub","s":"B"},{"t":"txt","s":" necesaria"}],"cifras":3},"exito":[{"t":"txt","s":"12 V entre 24 Ω: 500 mA; entre 10, 50 mA. Y el pin da como mucho 20 mA: ese es el resultado del análisis, no un detalle."}],"pistas":[{"texto":[{"t":"txt","s":"Se ha pasado. I"},{"t":"sub","s":"C"},{"t":"txt","s":" = 12 V / 24 Ω, y la base es la décima parte."}],"cuando":{"valor":"estimacion","min":0.052}},{"texto":[{"t":"txt","s":"Se ha quedado corto. Con β forzada de 10, la base lleva la décima parte de los 500 mA."}]}]},{"id":"salidas-6c","tipo":"pregunta","fase":"Pregunta","titulo":[{"t":"txt","s":"6.C: el pin no da"}],"texto":[{"t":"txt","s":"Un interruptor bipolar para 500 mA pide 50 mA de base y el pin del microcontrolador da 20 mA. ¿Cuál de estas no es una de las tres salidas del libro?"}],"libro":["cap06#478"],"fijar":{},"inicio":{},"opciones":[{"texto":[{"t":"txt","s":"Bajar la β forzada a 2 para que baste el pin"}],"bien":true,"porque":[{"t":"txt","s":"No es una de ellas: con tan poca sobreexcitación no se garantiza la saturación, y en activa disipa diez veces más."}]},{"texto":[{"t":"txt","s":"Un MOSFET, gobernado por tensión"}],"bien":false,"porque":[{"t":"txt","s":"Sí es una: no consume corriente de puerta. Es la solución del libro."}]},{"texto":[{"t":"txt","s":"Un Darlington, con 0,8 a 1 V de caída"}],"bien":false,"porque":[{"t":"txt","s":"Sí es una: multiplica la ganancia, a costa de más caída en saturación que los 0,2 V."}]}]},{"id":"frecuencia-6c","tipo":"pregunta","fase":"Pregunta","titulo":[{"t":"txt","s":"6.C: hasta qué frecuencia"}],"texto":[{"t":"txt","s":"El interruptor de 500 mA a 12 V disipa 100 mW en conducción. Con flancos de 1 µs, a 20 kHz las pérdidas de conmutación son 120 mW. ¿Qué significa?"}],"libro":["cap06#481","cap06#483","cap06#484"],"fijar":{},"inicio":{},"opciones":[{"texto":[{"t":"txt","s":"Que es el límite práctico: por encima, mandan las pérdidas de conmutación"}],"bien":true,"porque":[{"t":"txt","s":"A 20 kHz ya superan a las de conducción. Un bipolar saturado es lento al apagar: para más velocidad, MOSFET."}]},{"texto":[{"t":"txt","s":"Que hay que subir la corriente de base"}],"bien":false,"porque":[{"t":"txt","s":"Más base satura mejor pero apaga peor: más carga almacenada, flancos más lentos."}]},{"texto":[{"t":"txt","s":"Que el transistor no está saturado"}],"bien":false,"porque":[{"t":"txt","s":"Los 100 mW son los de saturación, 0,2 V por 0,5 A. Lo que crece con la frecuencia son los flancos."}]}]},{"id":"resumen","tipo":"resumen","fase":"Resumen","titulo":[{"t":"txt","s":"Lección completada"}],"texto":[],"libro":["cap06#447","cap06#466","cap06#477","cap06#484"],"fijar":{},"inicio":{},"ideas":[{"titulo":[{"t":"txt","s":"6.A."}],"texto":[{"t":"txt","s":"Con divisor y R"},{"t":"sub","s":"E"},{"t":"txt","s":", β varía un 500 % e I"},{"t":"sub","s":"C"},{"t":"txt","s":" un 14,9 %; 30 °C suman un 4,3 %."}]},{"titulo":[{"t":"txt","s":"6.B."}],"texto":[{"t":"txt","s":"Un espejo yerra 2/(β + 2) por la base y casi un 4 % por cada milivoltio de desapareamiento."}]},{"titulo":[{"t":"txt","s":"6.C."}],"texto":[{"t":"txt","s":"500 mA con β forzada de 10 piden 50 mA de base: el pin no da. MOSFET."}]},{"titulo":[{"t":"txt","s":"Límite."}],"texto":[{"t":"txt","s":"A 20 kHz la conmutación ya supera a la conducción: decenas de kilohercios."}]}]}]}
