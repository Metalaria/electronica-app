ada"}],"texto":[],"libro":["cap08#146","cap08#151","cap08#157","cap08#165"],"fijar":{},"inicio":{},"ideas":[{"titulo":[{"t":"txt","s":"La exactitud."}],"texto":[{"t":"txt","s":"La fija la referencia, no la resolución del convertidor."}]},{"titulo":[{"t":"txt","s":"Bandgap."}],"texto":[{"t":"txt","s":"Dos derivas opuestas se cancelan en unos 1,2 V."}]},{"titulo":[{"t":"txt","s":"Lo que manda."}],"texto":[{"t":"txt","s":"La deriva térmica no se calibra; la exactitud inicial, sí."}]},{"titulo":[{"t":"txt","s":"Ratiométrica."}],"texto":[{"t":"txt","s":"Sensor y ADC con la misma referencia: su error se cancela."}]}]}]}
