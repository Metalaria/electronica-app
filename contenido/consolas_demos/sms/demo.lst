   1                 	; «Paso a paso» demo for the Sega Master System II (Z80, VDP 315-5246 in mode 4).
   2                 	; A tiled background (sky, grass, bricks) and one 8x8 sprite that moves one pixel per frame.
   3                 	; The trace starts at the cartridge entry point $0000: on a real console the Sega boot ROM runs fir
   4                 	; checks the «TMR SEGA» header, maps the cartridge (port $3E) and jumps here.
   5                 	; Assembled with GNU as for the Z80 (binutils-z80); see build.sh. Licence: CC0 1.0.
   6                 	; Each «[tag]» names the Spanish explanation in explicaciones.es.txt.
   7                 	
   8                 	        .equ VDP_DATA, 0xBE           ; VDP data port
   9                 	        .equ VDP_CTRL, 0xBF           ; VDP control port (and status when read)
  10                 	        .equ SPRITE_X, 0xC000         ; RAM variable: sprite X position
  11                 	
  12                 	        .org 0x0000
  13                 	reset:
  14 0000 F3          	        di                            ; [di] no interrupts while we set up
  15 0001 ED 56       	        im 1                          ; [im1] mode 1: /INT always calls $0038
  16 0003 31 F0 DF    	        ld sp, 0xDFF0                 ; [sp] stack at the top of the 8 KB work RAM
  17 0006 C3 68 00    	        jp main                       ; [jpmain] skip over the interrupt vectors
  18                 	
  19 0009 00 00 00 00 	        .org 0x0038
  19      00 00 00 00 
  19      00 00 00 00 
  19      00 00 00 00 
  19      00 00 00 00 
  20                 	irq:
  21 0038 C3 EF 00    	        jp vblank                     ; [irq] frame interrupt entry (RST 38h)
  22                 	
  23 003b 00 00 00 00 	        .org 0x0066
  23      00 00 00 00 
  23      00 00 00 00 
  23      00 00 00 00 
  23      00 00 00 00 
  24                 	nmi:
  25 0066 ED 45       	        retn                          ; [nmi] pause button: ignored
  26                 	
  27                 	main:
  28 0068 21 00 01    	        ld hl, vdp_regs               ; [regs1] table of 11 register writes
  29 006b 06 16       	        ld b, vdp_regs_end - vdp_regs ; [regs2] 22 bytes: value, $80 + register number
  30 006d 0E BF       	        ld c, VDP_CTRL                ; [regs3] every byte goes to the control port
  31 006f ED B3       	        otir                          ; [regs4] out (c),(hl); hl++; b--; repeat while b != 0
  32                 	
  33 0071 AF          	        xor a                         ; [cram1] CRAM address 0 ...
  34 0072 D3 BF       	        out (VDP_CTRL), a             ; [cram2] ... low byte of the address
  35 0074 3E C0       	        ld a, 0xC0                    ; [cram3] code 3 = write to CRAM
  36 0076 D3 BF       	        out (VDP_CTRL), a             ; [cram4] second control byte
  37 0078 21 16 01    	        ld hl, palette                ; [cram5] 32 colours: 16 for tiles, 16 for sprites
  38 007b 06 20       	        ld b, 32                      ; [cram6]
  39 007d 0E BE       	        ld c, VDP_DATA                ; [cram7]
  40 007f ED B3       	        otir                          ; [cram8] copy the palette into CRAM
  41                 	
  42 0081 AF          	        xor a                         ; [vram1] VRAM address $0000 ...
  43 0082 D3 BF       	        out (VDP_CTRL), a             ; [vram2]
  44 0084 3E 40       	        ld a, 0x40                    ; [vram3] code 1 = write to VRAM
  45 0086 D3 BF       	        out (VDP_CTRL), a             ; [vram4]
  46 0088 21 36 01    	        ld hl, tiles                  ; [vram5] four 8x8 tiles, 32 bytes each
  47 008b 06 80       	        ld b, tiles_end - tiles       ; [vram6] 128 bytes
  48 008d ED B3       	        otir                          ; [vram7] (c) is still the data port
  49                 	
GAS LISTING /home/claude/app/contenido/consolas_demos/sms/demo.s 			page 2


  50 008f AF          	        xor a                         ; [map1] name table at $3800
  51 0090 D3 BF       	        out (VDP_CTRL), a             ; [map2]
  52 0092 3E 78       	        ld a, 0x78                    ; [map3] $38 + write code $40
  53 0094 D3 BF       	        out (VDP_CTRL), a             ; [map4]
  54 0096 16 10       	        ld d, 16                      ; [map5] 16 rows of sky (tile 0)
  55 0098 AF          	        xor a                         ; [map6]
  56 0099 CD CD 00    	        call fill_rows                ; [map7]
  57 009c 16 01       	        ld d, 1                       ; [map8] one row of grass (tile 1)
  58 009e 3E 01       	        ld a, 1                       ; [map9]
  59 00a0 CD CD 00    	        call fill_rows                ; [map10]
  60 00a3 16 07       	        ld d, 7                       ; [map11] seven rows of bricks (tile 2)
  61 00a5 3E 02       	        ld a, 2                       ; [map12]
  62 00a7 CD CD 00    	        call fill_rows                ; [map13]
  63                 	
  64 00aa 3E 40       	        ld a, 64                      ; [spr0] start the sprite at X = 64
  65 00ac 32 00 C0    	        ld (SPRITE_X), a              ; [spr0b]
  66 00af AF          	        xor a                         ; [spr1] sprite attribute table: Y list at $3F00
  67 00b0 D3 BF       	        out (VDP_CTRL), a             ; [spr2]
  68 00b2 3E 7F       	        ld a, 0x7F                    ; [spr3] $3F + write code $40
  69 00b4 D3 BF       	        out (VDP_CTRL), a             ; [spr4]
  70 00b6 3E 77       	        ld a, 119                     ; [spr5] sprite 0: Y = 119 (drawn from line 120)
  71 00b8 D3 BE       	        out (VDP_DATA), a             ; [spr6]
  72 00ba 3E D0       	        ld a, 0xD0                    ; [spr7] $D0 ends the sprite list
  73 00bc D3 BE       	        out (VDP_DATA), a             ; [spr8]
  74 00be CD DD 00    	        call put_sprite_x             ; [spr9] X and tile number at $3F80
  75                 	
  76 00c1 3E E0       	        ld a, 0xE0                    ; [on1] register 1: display on, frame interrupt on
  77 00c3 D3 BF       	        out (VDP_CTRL), a             ; [on2]
  78 00c5 3E 81       	        ld a, 0x81                    ; [on3]
  79 00c7 D3 BF       	        out (VDP_CTRL), a             ; [on4]
  80 00c9 FB          	        ei                            ; [ei] accept interrupts from now on
  81                 	loop:
  82 00ca 76          	        halt                          ; [halt] sleep until the next interrupt
  83 00cb 18 FD       	        jr loop                       ; [loop]
  84                 	
  85                 	; Fill D rows of 32 name-table entries with tile A (the VRAM address is already set).
  86                 	fill_rows:
  87 00cd 1E 20       	        ld e, 32                      ; [row1] 32 columns per row
  88                 	fill_entry:
  89 00cf D3 BE       	        out (VDP_DATA), a             ; [row2] low byte: tile number
  90 00d1 08          	        ex af, af'                    ; [row3] keep the tile number in the shadow A
  91 00d2 AF          	        xor a                         ; [row4] high byte: no flip, palette 0, behind sprites
  92 00d3 D3 BE       	        out (VDP_DATA), a             ; [row5]
  93 00d5 08          	        ex af, af'                    ; [row6]
  94 00d6 1D          	        dec e                         ; [row7]
  95 00d7 20 F6       	        jr nz, fill_entry             ; [row8]
  96 00d9 15          	        dec d                         ; [row9]
  97 00da 20 F1       	        jr nz, fill_rows              ; [row10]
  98 00dc C9          	        ret                           ; [row11]
  99                 	
 100                 	; Write the sprite's X and tile number at $3F80.
 101                 	put_sprite_x:
 102 00dd 3E 80       	        ld a, 0x80                    ; [px1] VRAM address $3F80 ...
 103 00df D3 BF       	        out (VDP_CTRL), a             ; [px2]
 104 00e1 3E 7F       	        ld a, 0x7F                    ; [px3] $3F + write code $40
 105 00e3 D3 BF       	        out (VDP_CTRL), a             ; [px4]
 106 00e5 3A 00 C0    	        ld a, (SPRITE_X)              ; [px5] read the position from RAM
GAS LISTING /home/claude/app/contenido/consolas_demos/sms/demo.s 			page 3


 107 00e8 D3 BE       	        out (VDP_DATA), a             ; [px6] X
 108 00ea 3E 03       	        ld a, 3                       ; [px7] tile 3: the ball
 109 00ec D3 BE       	        out (VDP_DATA), a             ; [px8]
 110 00ee C9          	        ret                           ; [px9]
 111                 	
 112                 	; Frame interrupt: the VDP pulls /INT low when line 193 starts (first line after the picture).
 113                 	vblank:
 114 00ef F5          	        push af                       ; [vb1] save the registers we use
 115 00f0 DB BF       	        in a, (VDP_CTRL)              ; [vb2] reading the status releases /INT
 116 00f2 3A 00 C0    	        ld a, (SPRITE_X)              ; [vb3]
 117 00f5 3C          	        inc a                         ; [vb4] one pixel to the right
 118 00f6 32 00 C0    	        ld (SPRITE_X), a              ; [vb5]
 119 00f9 CD DD 00    	        call put_sprite_x             ; [vb6] the VRAM copy is read on the next frame
 120 00fc F1          	        pop af                        ; [vb7]
 121 00fd FB          	        ei                            ; [vb8] interrupts were disabled by the acknowledge
 122 00fe ED 4D       	        reti                          ; [vb9]
 123                 	
 124                 	vdp_regs:
 125 0100 06 80       	        .byte 0x06, 0x80              ; R0: mode 4
 126 0102 80 81       	        .byte 0x80, 0x81              ; R1: display off for now
 127 0104 FF 82       	        .byte 0xFF, 0x82              ; R2: name table at $3800
 128 0106 FF 83       	        .byte 0xFF, 0x83              ; R3: unused in mode 4
 129 0108 FF 84       	        .byte 0xFF, 0x84              ; R4: unused in mode 4
 130 010a FF 85       	        .byte 0xFF, 0x85              ; R5: sprite attribute table at $3F00
 131 010c FB 86       	        .byte 0xFB, 0x86              ; R6: sprite tiles from $0000
 132 010e 00 87       	        .byte 0x00, 0x87              ; R7: border = sprite colour 0
 133 0110 00 88       	        .byte 0x00, 0x88              ; R8: no horizontal scroll
 134 0112 00 89       	        .byte 0x00, 0x89              ; R9: no vertical scroll
 135 0114 FF 8A       	        .byte 0xFF, 0x8A              ; R10: no line interrupt
 136                 	vdp_regs_end:
 137                 	
 138                 	palette:
 139                 	        ; Background: 0 black, 1 sky, 2 light green, 3 dark green, 4 brick, 5 mortar, 6 dark brick
