#let resumen = resumen-capitulo([Casi todo lo que se mueve en una fábrica sigue una secuencia, y el capítulo trata de cómo se construye. Con contactores, el circuito de mando hace lógica con contactos: la autorretención, con prioridad de paro y sin rearranque al volver la tensión; los enclavamientos eléctrico y mecánico de la inversión de giro; y el arranque estrella\-triángulo, que divide por tres la corriente y el par de arranque y necesita una pausa entre contactores. Los sensores industriales (finales de carrera, detectores inductivos, capacitivos y fotoeléctricos) trabajan a 24 V, PNP o NPN, de tres o de dos hilos, y se diseñan con su distancia asegurada y el factor del material. El autómata programable es un ordenador hecho para el armario: sus entradas de 24 V son de los tipos de la IEC 61131\-2, y un detector de dos hilos exige comprobar su corriente residual y su caída. Ejecuta el programa en un ciclo de scan sobre una imagen de proceso, su tiempo de respuesta va de uno a dos ciclos y puede no ver los pulsos más cortos que el ciclo. Se programa en los lenguajes de la IEC 61131\-3, y las secuencias se especifican con GRAFCET y se traducen a programa con reglas fijas. La parada de emergencia no la gestiona el autómata, sino un relé de seguridad de dos canales con contactos guiados, y la fiabilidad de cada función de seguridad la fijan los niveles de prestaciones de la ISO 13849\-1. El capítulo termina comparando el autómata con el microcontrolador y con una estación de marcado llevada de la especificación al programa.])
#let formulas = formulas-capitulo((([Autorretención con prioridad de paro], $ "KM1" = ( "S1" + "KM1" ) dot.op overline("S0") dot.op overline("F2") $, "sec-55.1", "?", false), ([Arranque estrella\-triángulo], $ I_("arr,Y") = (I_("arr,Δ"))/("3") quad quad T_("arr,Y") = (T_("arr,Δ"))/("3") quad quad I_("KM1") = I_("KM2") = (I_("n"))/(sqrt("3")) $, "sec-55.1", "?", true), ([Distancia de trabajo asegurada de un detector], $ S_("a") <= "0,81" dot.op S_("n") dot.op k_("material") $, "sec-55.2", "?", true), ([Resistencia en paralelo para un detector de dos hilos], $ R_("p") <= (V_("0,máx") dot.op R_("ent"))/(I_("res") dot.op R_("ent") - V_("0,máx")) $, "sec-55.3", "?", true), ([Tiempo de respuesta de un autómata cíclico], $ t_("e") + T_("c") + t_("s") <= t_("r") <= t_("e") + "2" dot.op T_("c") + t_("s") $, "sec-55.4", "?", true), ([Probabilidad de ver un pulso corto], $ P = t_("p")/T_("c") quad lr(( t_("p") < T_("c") )) $, "sec-55.4", "?", true), ([Periodo de un intermitente con dos TON], $ T = "2" dot.op ⌈ (P T)/(T_("c")) ⌉ dot.op T_("c") + "2" dot.op T_("c") $, "sec-55.5", "?", false)))

