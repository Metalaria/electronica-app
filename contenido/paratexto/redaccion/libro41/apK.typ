// apK.typ: paratext of the appendix new in edition 4.1 «Fundamentos de C para Sistemas Empotrados» (proposal P12),
// written by hand with the appendix (job libro-p10); the numbers shown come from NUMS when the book is built.

#import "paratexto.typ": *

#let niveles = ("ej-K.1": 2, "ej-K.2": 1, "ej-K.3": 1, "ej-K.4": 2, "ej-K.5": 2, "ej-K.6": 2)
#let objetivos-cap = objetivos([Elegir los tipos enteros de tamaño fijo y manejar bits, máscaras y campos de un registro.], [Predecir el tamaño y la disposición de una estructura en distintos procesadores y transmitir datos sin depender de ellos.], [Situar cada parte de un programa en la memoria y usar volatile, const y las secciones críticas donde hacen falta.], [Programar máquinas de estados que no bloquean y búferes circulares entre una interrupción y el programa.], [Decidir entre coma flotante y coma fija con el coste de cada operación, y medir el tiempo sin errores de desbordamiento.], [Reconocer la promoción de enteros, los desbordamientos y el comportamiento indefinido, y defenderse de ellos.])
#let terminos = terminos-clave(("Búfer circular", "sec-K.4", "K.4"), ("Coma fija", "sec-K.5", "K.5"), ("Comportamiento indefinido", "sec-K.6", "K.6"), ("Máquina de estados", "sec-K.4", "K.4"), ("Promoción de enteros", "sec-K.6", "K.6"), ("Relleno (padding)", "sec-K.2", "K.2"), ("Sección crítica", "sec-K.3", "K.3"), ("Variable volátil (volatile)", "sec-K.3", "K.3"))
#let grado = grado-capitulo(materias: ("Informática", "Sistemas Electrónicos Digitales y Microprocesadores"), competencias: (("FB3", "informática y programación"), ("TE3", "electrónica digital y microprocesadores")))
#let inicio = sin-glosario({ objetivos-cap; terminos; grado })

#let resumen = resumen-capitulo([El apéndice reúne lo que el C de un microcontrolador tiene de particular. El tamaño de los tipos depende del procesador (un int tiene 16 bits en el AVR y 32 en un Cortex-M), y por eso se usan los de tamaño fijo y las constantes sin signo para las máscaras; los campos de un registro se leen y escriben con desplazamientos y máscaras. Las estructuras llevan relleno para alinear sus campos, distinto en cada procesador, y los datos que salen por un bus se escriben byte a byte. El enlazador reparte el programa entre la Flash y la RAM, y en el AVR las constantes se copian a la RAM salvo que se declaren en la Flash. Volatile obliga a hacer cada acceso, pero no lo hace atómico ni ordena los demás, y una variable de varios bytes que cambia una interrupción se lee en una sección crítica. Las máquinas de estados y los búferes circulares son las estructuras de cada día, y sus detalles (tiempos máximos, índices de un byte que cuentan libremente) los hacen robustos. Sin coma flotante en hardware, cada operación tiene su coste, y la coma fija redondea y satura. Los errores típicos salen de la promoción de enteros, de los desbordamientos y del comportamiento indefinido, y se combaten con los avisos del compilador, las pruebas en el PC y las reglas de codificación.])
#let formulas = formulas-capitulo((([Valor de un número en Q16.16], $ x = n / "65 536" quad quad -"32 768" lt.eq x < "32 768" $, "sec-K.5", "K.5", false), ([Datos en un búfer circular de índices que cuentan libremente], $ N = ("cabeza" - "cola") op("mod") "256" quad quad "posición" = "índice" op("mod") "TAM" $, "sec-K.4", "K.4", false), ([Lectura de un convertidor de 10 bits en milivoltios (referencia de 5 V)], $ "mV" = ("lectura" dot.op "5000" + "512")/("1024") $, "sec-K.5", "K.5", false)))
#let autoev = autoevaluacion("apK", (("apK-01", [En el avr-gcc de un Arduino UNO, ¿cuántos bits tiene un int?], none, [bits]), ("apK-02", [¿Cuánto ocupa en un Cortex-M una estructura con un uint8_t, un uint32_t y un uint8_t, en ese orden?], none, [bytes]), ("apK-03", [¿Qué garantiza volatile?], ([Que el acceso a la variable sea atómico], [Que cada lectura y escritura del código se haga de verdad, en orden respecto a los demás accesos volatile], [Que la variable quede en la Flash], [Que el compilador no mueva ningún cálculo alrededor de ella]), none), ("apK-04", [¿Por qué los índices del búfer circular del apéndice son de 8 bits y cuentan libremente?], ([Porque así ocupan menos memoria], [Porque el AVR no puede sumar números de 16 bits], [Porque su acceso es atómico en el AVR y su diferencia distingue el búfer lleno del vacío], [Porque el tamaño del búfer debe ser 256]), none), ("apK-05", [En un Arduino UNO, ¿qué valor acaba en uint32_t g = 1000 \* 60?], ([60 000], [Comportamiento indefinido: el producto de dos int de 16 bits se desborda; en la práctica, 4 294 961 760], [0], [Un error de compilación]), none), ("apK-06", [¿Cuántos ciclos cuesta, aproximadamente, una división de 32 bits en el ATmega328P?], ([Uno], [Unos 20], [Unos 600], [Unos 6 000]), none)))
#let normas = normas-referencias(normas: (([ISO\/IEC 9899 (lenguaje C)], [El estándar del lenguaje: tamaños mínimos de los tipos, conversiones y comportamiento indefinido.], (("sec-K.1", "K.1"), ("sec-K.6", "K.6"))), ([MISRA C], [Reglas de codificación de C para sistemas críticos, nacidas en la industria del automóvil.], (("sec-K.6", "K.6"),))), lecturas: (([Brian W. Kernighan y Dennis M. Ritchie, «The C Programming Language», Prentice Hall, 2.ª ed., 1988. Hay edición en español: «El lenguaje de programación C», Prentice Hall Hispanoamericana, 2.ª ed., 1991.], "sugerencia"), ([Michael Barr, «Embedded C Coding Standard» (BARR\-C:2018), Barr Group, 2018. Se descarga gratis de la web de Barr Group.], "sugerencia"), ([Elecia White, «Making Embedded Systems: Design Patterns for Great Software», O\'Reilly, 2.ª ed., 2024.], "sugerencia"),))
#let cierre = { resumen; normas; formulas; autoev }

#let soluciones = ("apK", [Apéndice K], [Fundamentos de C para Sistemas Empotrados], (("apK-01", [16 bits], [Va de −32 768 a 32 767; en un Cortex-M y en un PC tiene 32. Por eso el tamaño se escribe en el nombre del tipo: int16\_t, uint32\_t.], "sec-K.1", "K.1"), ("apK-02", [12 bytes], [Tres de relleno tras el primer campo para alinear el uint32\_t y tres al final; ordenada de mayor a menor ocupa 8, y en el AVR, 6.], "sec-K.2", "K.2"), ("apK-03", [b) Que cada lectura y escritura del código se haga de verdad, en orden respecto a los demás accesos volatile], [No hace atómico el acceso ni impide mover cálculos que no son volatile; para lo primero hace falta una sección crítica.], "sec-K.3", "K.3"), ("apK-04", [c) Porque su acceso es atómico en el AVR y su diferencia distingue el búfer lleno del vacío], [Con un productor y un consumidor no hace falta sección crítica; con índices de 16 bits sí (problema 38.C).], "sec-K.4", "K.4"), ("apK-05", [b) Comportamiento indefinido: el producto de dos int de 16 bits se desborda; en la práctica, 4 294 961 760], [El tipo de una operación lo deciden sus operandos, no el destino: 1000ul \* 60 da 60 000 en cualquier compilador.], "sec-K.6", "K.6"), ("apK-06", [c) Unos 600], [628 ciclos medidos, 40 µs a 16 MHz: el AVR no divide en hardware. La suma de 32 bits cuesta 26 y la de float, 144.], "sec-K.5", "K.5")))
