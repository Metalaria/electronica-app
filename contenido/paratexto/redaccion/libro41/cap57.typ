#let resumen = resumen-capitulo([Un robot reúne motores, puentes, encoders, IMU, lazos de control, temporizadores, baterías y seguridad de máquinas, y el capítulo trata de la electrónica que los une. Sus lazos están anidados y trabajan a frecuencias muy distintas, de la planificación a unos hercios al lazo de corriente a decenas de kilohercios, lo que permite repartirlos entre procesadores. La cinemática de un brazo de tres ejes da los ángulos que hay que pedir a cada motor, y en su forma general, con transformaciones homogéneas y los parámetros de Denavit\-Hartenberg, es el modelo que guarda el controlador de cualquier robot; su jacobiano da las velocidades, las singularidades y la resolución en la punta, y el par estático del peor caso, el tamaño de los motores. Los tres actuadores de un robot pequeño tienen su electrónica: el motorreductor, un puente en H cuya caída y cuya corriente de bloqueo hay que contar; el servo de modelismo, un pulso de 50 Hz que un temporizador genera sin coste; y el paso a paso, un driver con troceador y micropaso cuya velocidad útil crece con la tensión. Un eje con encoder necesita estimar la velocidad sin la cuantificación del método de contar cuentas, y su servo de posición sigue mejor un perfil trapezoidal con acción anticipativa que con un PID solo. La odometría de un robot diferencial deriva por los errores sistemáticos de sus ruedas, y un giróscopo corrige la orientación. Las normas de robots añaden las funciones de seguridad, la función STO y las distancias de las protecciones. Un robot industrial se programa en los sistemas de coordenadas de la base, la herramienta y la pieza, con movimientos articulares, lineales y circulares, enseñando los puntos con la consola, que aprovecha su repetibilidad, o fuera de línea, que depende de su exactitud y de su calibración. Un brazo de tres ejes construido por etapas y un robot móvil dimensionado de principio a fin cierran el capítulo.])
#let formulas = formulas-capitulo((([Cinemática directa del brazo plano], $ r = L_("1") cos θ_("2") + L_("2") cos (θ_("2") + θ_("3")) quad quad z = L_("1") op("sen") θ_("2") + L_("2") op("sen") (θ_("2") + θ_("3")) $, "sec-57.2", "54.2", false), ([Cinemática inversa: el codo], $ cos θ_("3") = (r^("2") + z^("2") - L_("1")^("2") - L_("2")^("2"))/("2" L_("1") L_("2")) $, "sec-57.2", "54.2", true), ([Cadena de transformaciones homogéneas (Denavit\-Hartenberg)], $ T_("03") = A_("1") dot.op A_("2") dot.op A_("3") quad quad A_("i") = op("Rot")_(z)(θ_("i")) dot.op op("Tras")_(z)(d_("i")) dot.op op("Tras")_(x)(a_("i")) dot.op op("Rot")_(x)(α_("i")) $, "sec-57.2", "54.2", false), ([Determinante del jacobiano: singularidades], $ det J = L_("1") dot.op L_("2") dot.op op("sen") θ_("3") $, "sec-57.2", "54.2", true), ([Corriente del troceador del DRV8825], $ I = V_("REF")/("5" dot.op R_("SENSE")) $, "sec-57.3", "54.3", true), ([Incremento de par de un micropaso de 1\/n], $ Δ T = T_("ret") dot.op op("sen") ("90°")/n $, "sec-57.3", "54.3", true), ([Escalón de velocidad del método M], $ Δ n = ("60")/(N_("cuentas") dot.op T_("s")) $, "sec-57.4", "54.4", true), ([Duración de un perfil trapezoidal], $ T = θ/v_("máx") + v_("máx")/a_("máx") quad lr(( θ gt.eq v_("máx")^("2")/a_("máx") )) $, "sec-57.4", "54.4", true), ([Cinemática del robot diferencial], $ v = (v_("d") + v_("i"))/"2" quad quad ω = (v_("d") - v_("i"))/b $, "sec-57.5", "54.5", true), ([Distancia de una protección (ISO 13855)], $ S = K dot.op T + D_("DS") + Z $, "sec-57.6", "54.6", true)))
#let autoev = autoevaluacion("cap57", (("cap57-01", [Un motorreductor 1:30 lleva un encoder de 11 líneas en el eje del motor. Con decodificación ×4, ¿cuántas cuentas da por vuelta del eje de salida?], none, [cuentas]), ("cap57-02", [¿Por qué la cinemática inversa del brazo plano de dos segmentos tiene, en general, dos soluciones?], ([Porque la base puede girar a un lado o al otro], [Porque el arcocoseno del codo admite los dos signos: codo arriba y codo abajo], [Porque el jacobiano tiene dos autovalores], [Porque los servos admiten dos sentidos de giro]), none), ("cap57-03", [Con 1 320 cuentas por vuelta y un periodo de muestreo de 1 ms, ¿qué escalón de velocidad da contar las cuentas de cada periodo, en rpm?], none, [rpm]), ("cap57-04", [¿Qué aporta la acción anticipativa al servo de posición de un eje?], ([Sustituye al PID cuando el modelo es bueno], [Elimina la cuantificación del encoder], [Da la tensión que el modelo prevé para la velocidad y la aceleración pedidas, y deja al PID solo la corrección], [Limita la corriente del puente durante la aceleración]), none), ("cap57-05", [Un eje sigue un perfil trapezoidal con 4 rad\/s y 20 rad\/s². ¿Cuánto dura un giro de 90°, en s?], none, [s]), ("cap57-06", [La rueda derecha de un robot diferencial es un 0,5 % mayor que la izquierda. ¿Qué hace que su error de posición crezca tanto con el recorrido?], ([El error de la distancia recorrida, que se acumula linealmente], [El ruido de los encoders], [El error de orientación, que desvía cada tramo y se convierte en error de posición creciente], [El deslizamiento de las ruedas]), none), ("cap57-07", [¿Qué hace la función STO de un accionamiento?], ([Frena el motor con una rampa controlada], [Corta por dos canales la alimentación de los drivers de puerta, de modo que el motor no puede dar par], [Abre el contactor de la red], [Limita la velocidad a 250 mm\/s]), none), ("cap57-08", [Un DRV8825 con resistencias de 0,100 Ω debe limitar la corriente de fase a 1,5 A. ¿Qué tensión de referencia hay que ajustar, en V?], none, [V]), ("cap57-09", [En la tabla de Denavit\-Hartenberg del brazo, ¿qué parámetro dice que el eje del hombro es perpendicular al de la base?], ([d#sub[1] \= 0], [a#sub[2] \= L#sub[1]], [α#sub[1] \= 90°], [θ#sub[1]]), none), ("cap57-10", [Las posiciones de un programa enseñado con la consola dependen sobre todo de...], ([La exactitud del robot], [La repetibilidad del robot], [La calibración de los parámetros de Denavit\-Hartenberg], [La resolución de la consola]), none)))
#let normas = normas-referencias(normas: (([ISO 8373], [Vocabulario de la robótica: la definición de robot industrial.], (("sec-57.1", "54.1"),)), ([ISO 10218-1 e ISO 10218-2 (2025)], [Requisitos de seguridad del robot industrial y de su aplicación y su célula; la parte 2 incorpora la ISO\/TS 15066 sobre aplicaciones colaborativas.], (("sec-57.6", "54.6"),)), ([ISO 13849-1 e IEC 60204-1], [Niveles de prestaciones de las funciones de seguridad y categorías de parada del equipo eléctrico de las máquinas.], (("sec-57.6", "54.6"),)), ([ISO 13855 (2024)], [Distancia mínima de las protecciones a la zona de peligro según la velocidad de aproximación del cuerpo.], (("sec-57.6", "54.6"),)), ([IEC 61800-5-2], [Funciones de seguridad de los accionamientos eléctricos, entre ellas la desconexión segura del par (STO).], (("sec-57.6", "54.6"),)), ([ISO 9283], [Criterios de prestaciones de los robots industriales y cómo se miden: repetibilidad y exactitud de posición y de trayectoria.], (("sec-57.7", "54.7"),))), lecturas: (([John J. Craig, «Introduction to Robotics: Mechanics and Control», Pearson, 4.ª ed., 2017.], "sugerencia"), ([Bruno Siciliano, Lorenzo Sciavicco, Luigi Villani y Giuseppe Oriolo, «Robotics: Modelling, Planning and Control», Springer, 2009.], "sugerencia"), ([Peter Corke, «Robotics, Vision and Control: Fundamental Algorithms in Python», Springer, 3.ª ed., 2023.], "sugerencia"),))
#let cierre = { resumen; normas; formulas; autoev }

#let soluciones = ("cap57", [Capítulo 54], [Electrónica para Sistemas Robotizados], (("cap57-01", [1 320 cuentas], [11 ciclos por vuelta del motor, por 4 flancos, por 30 vueltas del motor por cada una de la salida: 0,273° por cuenta.], "sec-57.4", "54.4"), ("cap57-02", [b) Porque el arcocoseno del codo admite los dos signos: codo arriba y codo abajo], [Las dos llevan la punta al mismo sitio; el controlador elige una y no la cambia a mitad de un movimiento.], "sec-57.2", "54.2"), ("cap57-03", [45,5 rpm], [Una cuenta por milisegundo son 60\/(1 320 × 0,001) = 45,5 rpm: a baja velocidad la estimación salta entre 0 y 45,5. Una ventana de 10 ms da 4,5 rpm; medir el tiempo entre flancos, mucho menos.], "sec-57.4", "54.4"), ("cap57-04", [c) Da la tensión que el modelo prevé para la velocidad y la aceleración pedidas, y deja al PID solo la corrección], [En la simulación del capítulo, el error máximo baja de 2,18° con el PID solo a 0,38° con la anticipación.], "sec-57.4", "54.4"), ("cap57-05", [0,593 s], [Acelera 0,2 s (0,4 rad), sigue 0,193 s a 4 rad\/s (0,771 rad) y frena 0,2 s (0,4 rad): 1,571 rad en total.], "sec-57.4", "54.4"), ("cap57-06", [c) El error de orientación, que desvía cada tramo y se convierte en error de posición creciente], [Tras 10 m con vía de 150 mm, el robot ha girado 19,1° sin saberlo y está a 1,66 m de donde cree; un giróscopo lo reduce a centímetros.], "sec-57.5", "54.5"), ("cap57-07", [b) Corta por dos canales la alimentación de los drivers de puerta, de modo que el motor no puede dar par], [No hace falta abrir el contactor, y el motor queda sin par aunque falle el procesador del accionamiento; los ejes con gravedad necesitan además el freno.], "sec-57.6", "54.6"), ("cap57-08", [0,75 V], [I = V#sub[REF]\/(5 × 0,100 Ω): V#sub[REF] = 1,5 × 0,5 = 0,75 V, que se ajusta con el potenciómetro de la placa.], "sec-57.3", "54.3"), ("cap57-09", [c) α#sub[1] \= 90°], [El giro α alrededor de x#sub[1] lleva z#sub[0], vertical, a z#sub[1], horizontal: los dos ejes son perpendiculares. d y a son distancias, y θ#sub[1] es la variable de la base.], "sec-57.2", "54.2"), ("cap57-10", [b) La repetibilidad del robot], [El punto se guarda con los mismos ángulos que luego se piden, así que el robot vuelve a él con su repetibilidad, de centésimas de milímetro; la programación fuera de línea depende de la exactitud, mucho peor sin calibrar.], "sec-57.7", "54.7")))
